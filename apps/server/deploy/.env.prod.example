# /home/deploy/tcli/.env.prod — create by hand on the server, chmod 600.
# Never commit real values. Generate secrets with: openssl rand -base64 48
DATABASE_URL=postgres://tcli:<password from init-db.sh>@postgres:5432/tcli
JWT_SECRET=<openssl rand -base64 48>
DEEPSEEK_API_KEY=<key>
DEEPSEEK_MODEL=deepseek-v4-flash
WECHAT_APPID=<mini-program appid>
WECHAT_SECRET=<mini-program app secret>
LOG_LEVEL=info
# Text to speech (POST /v1/tts, Microsoft Edge Read Aloud; no secret needed).
# Defaults shown. The cache lives in the API's memory (mem_limit 256m): keep it small.
TTS_ENABLED=true
TTS_REQUESTS_PER_MINUTE=30
TTS_TIMEOUT_MS=15000
TTS_CACHE_MAX_BYTES=16777216

# ---- M3–M5 (docs/api-v1.md, "Learning"). Every line below is optional; defaults shown. ----
# In-process scheduler: nightly AI pipeline (05:00 Asia/Shanghai) and hourly reminders.
JOBS_ENABLED=true
# Interactive AI tokens per account per day; nightly pipeline tokens per account per run.
AI_TOKENS_PER_DAY=300000
AI_PIPELINE_TOKENS_PER_RUN=200000
# Daily review limits (D10) and the "已掌握" threshold.
REVIEW_NEW_PER_DAY=15
REVIEW_MAX_PER_DAY=60
MASTERED_DAYS=180
# Operator alert mail (job failures, regeneration failures, token budget). All three
# unset → alerts are log lines only. The SMTP password goes inside the URL; never commit it.
# ALERT_SMTP_URL=smtps://<user>:<password>@smtp.example.com:465
# ALERT_EMAIL_FROM=<sender address>
# ALERT_EMAIL_TO=<your address>
# Review reminders (WeChat subscribe message). Needs a template chosen in the admin
# console (which needs a 服务类目). Unset → reminders off and hidden in the app.
# WECHAT_REMINDER_TEMPLATE_ID=<template id>
# WECHAT_REMINDER_DATA={"thing1":{"value":"今天有 {due} 张卡片待复习"},"date2":{"value":"{date}"}}
# WECHAT_REMINDER_MINIPROGRAM_STATE=trial
