# /home/deploy/tcli/.env.prod — create by hand on the server, chmod 600.
# Never commit real values. Generate secrets with: openssl rand -base64 48
DATABASE_URL=postgres://tcli:<password from init-db.sh>@postgres:5432/tcli
JWT_SECRET=<openssl rand -base64 48>
DEEPSEEK_API_KEY=<key>
DEEPSEEK_MODEL=deepseek-v4-flash
WECHAT_APPID=<mini-program appid>
WECHAT_SECRET=<mini-program app secret>
LOG_LEVEL=info
