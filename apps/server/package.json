{
  "name": "@t-cli/server",
  "version": "0.1.0",
  "private": true,
  "description": "t-cli sync service: accounts, record sync and the AI proxy for the mini-program.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrateCli.ts",
    "admin": "node scripts/admin.ts"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@t-cli/core": "0.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "msedge-tts": "2.0.6",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  }
}
