{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type checking only. The mini-program compiler ignores this file: WeChat
  // DevTools and miniprogram-ci transpile each .ts with Babel
  // (`useCompilerPlugins: ["typescript"]` in project.config.json) and turn ES
  // modules into the CommonJS the runtime loads. Hence `noEmit`, extensionless
  // relative imports (`Bundler` resolution) and no Node types: `process` and
  // `Buffer` do not exist in the mini-program runtime.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["miniprogram-api-typings"],
    "noEmit": true,

    // Modules under miniprogram/lib are also loaded by `node --test` through
    // type stripping, so they must stay erasable and import types with
    // `import type` (a plain import of a type would survive stripping and
    // fail to resolve at runtime).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    // miniprogram/vendor holds JS copied from packages/core (see
    // scripts/sync-core.mjs); its JSDoc supplies the types.
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.ts"]
}
