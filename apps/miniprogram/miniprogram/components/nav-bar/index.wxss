/* Colours come from the page root's CSS variables (they inherit into components). */
.nav {
  flex-shrink: 0;
  background-color: var(--bg);
}

.bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 40rpx;
}

/* The back target: the bar's full height, 76rpx wide. */
.back {
  display: flex;
  align-items: center;
  height: 100%;
  margin-left: -16rpx;
  padding: 0 16rpx;
}

/* A heading of the type scale (app.wxss .t-heading: 34rpx, 600, line height 1.4). */
.title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* app.wxss's .pressed does not reach into components: the same press state here. */
.pressed {
  opacity: 0.55;
}
