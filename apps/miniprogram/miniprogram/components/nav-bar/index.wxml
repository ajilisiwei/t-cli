<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="bar" style="height: {{barHeight}}px;">
    <view
      wx:if="{{back}}"
      class="back"
      bindtap="onBack"
      hover-class="pressed"
      hover-stay-time="80"
      aria-role="button"
      aria-label="返回"
    >
      <t-icon name="chevron-left" tone="ink" size="44" />
    </view>
    <text class="title">{{title}}</text>
  </view>
</view>
