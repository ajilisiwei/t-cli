/*
 * The design system (see README "Design system").
 *
 * Paper-like and quiet: off-white ground, ink text, one indigo accent; thin
 * rules and whitespace instead of shadows. English results use a serif,
 * everything else the system font.
 *
 * Colours are CSS variables on the page root (`theme-light` / `theme-dark`,
 * set from the system theme in JS) so they work the same under Skyline and
 * WebView; lib/palette.ts mirrors them for icons and gradients. Secondary
 * text meets 4.5:1 against the ground in both themes.
 *
 * Skyline limits shape the components below: a rounded box takes one border
 * colour for all four sides, there is no currentColor, and text glyphs such
 * as ▶︎ ✓ › turn into emoji on iOS. So icons are <t-icon> SVGs, never
 * characters, and shapes never rely on per-side border colours.
 */
.theme-light {
  --bg: #f7f5f0;
  --ink: #1d1c1a;
  --ink-soft: #46433d;
  --muted: #6f6a62;
  --rule: #e2ddd3;
  --accent: #2f3e7a;
  --accent-soft: rgba(47, 62, 122, 0.12);
  --accent-ink: #ffffff;
  --surface: #fffefb;
  --danger: #9c3426;
}

.theme-dark {
  --bg: #131312;
  --ink: #ebe8e1;
  --ink-soft: #c9c4ba;
  --muted: #8f8a80;
  --rule: #2c2b28;
  --accent: #9fb0ee;
  --accent-soft: rgba(159, 176, 238, 0.16);
  --accent-ink: #131312;
  --surface: #1c1c1a;
  --danger: #e59a8c;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
}

/* The scrolling area below the navigation bar. */
.body {
  flex: 1;
  height: 0;
}

.content {
  padding: 16rpx 40rpx 96rpx;
}

.serif {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
}

.muted {
  color: var(--muted);
}

.rule {
  height: 1px;
  background-color: var(--rule);
}

.error {
  display: block;
  margin-top: 16rpx;
  color: var(--danger);
  font-size: 28rpx;
}

.placeholder {
  color: var(--muted);
}

/* ---- composer: the input area of 翻译 and 纠错 ----
 * One quiet surface: a slightly lighter (dark: lighter) panel with a hairline
 * border that turns indigo while typing. Input on top, a bar below with a
 * hint on the left and clear / mic / send on the right. No shadow. */
.composer {
  margin-top: 8rpx;
  padding: 24rpx 28rpx 20rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 28rpx;
}

.composer-focused {
  border-color: var(--accent);
}

.composer-input {
  width: 100%;
  min-height: 156rpx;
  font-size: 34rpx;
  line-height: 1.55;
  color: var(--ink);
}

.composer-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  margin-top: 12rpx;
}

.composer-hint {
  color: var(--muted);
  font-size: 24rpx;
}

.composer-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}

.hint {
  display: block;
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 26rpx;
}

/* ---- result area ---- */
.result {
  padding: 40rpx 8rpx 0;
}

.direction {
  display: block;
  margin-bottom: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.direction-flip {
  color: var(--accent);
}

.output {
  display: block;
  font-size: 36rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.output-en {
  font-size: 44rpx;
  line-height: 1.45;
}

.headline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
}

.head {
  margin-right: 20rpx;
  font-size: 56rpx;
  line-height: 1.3;
}

.ipa {
  color: var(--muted);
  font-size: 30rpx;
}

.gloss {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
}

.explanation {
  display: block;
  margin-top: 32rpx;
  color: var(--ink-soft);
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1px solid var(--rule);
}

/* ---- word diff (纠错) ---- */
.diff-delete {
  color: var(--muted);
  text-decoration: line-through;
}

.diff-insert {
  color: var(--accent);
  background-color: var(--accent-soft);
}

/* ---- lists (我的, 记录, 设备) ---- */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1px solid var(--rule);
}

.row-label {
  font-size: 32rpx;
}

.row-value {
  color: var(--muted);
  font-size: 28rpx;
}

.section-title {
  display: block;
  margin-top: 48rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.segmented {
  display: flex;
  flex-direction: row;
}

.segment {
  margin-left: 32rpx;
  color: var(--muted);
  font-size: 30rpx;
}

.segment-on {
  color: var(--accent);
  font-weight: 600;
}

.field {
  display: block;
  width: 100%;
  height: 96rpx;
  border-bottom: 1px solid var(--rule);
  color: var(--ink);
  font-size: 40rpx;
  letter-spacing: 8rpx;
}

.notice {
  display: block;
  margin-top: 32rpx;
  color: var(--ink-soft);
  font-size: 30rpx;
}

.empty {
  display: block;
  padding: 96rpx 0;
  color: var(--muted);
  text-align: center;
  font-size: 28rpx;
}

/* ---- buttons ----
 * One shape, the pill. Weights:
 *   .btn-primary    filled indigo — the one main action of a screen
 *   .btn-secondary  surface + hairline — other actions
 *   .btn-tonal      indigo tint — inline actions next to content (朗读, 复制)
 *   .btn-danger     danger hairline — destructive
 * Sizes: default 88rpx, .btn-sm 64rpx (inline), .btn-lg 96rpx (docked).
 * An icon goes first: <view class="btn btn-tonal btn-sm"><t-icon …/><text>朗读</text></view>.
 */
.btn {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-sm {
  gap: 8rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.btn-lg {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}

/* A small pill that starts with an icon: less padding on the icon side
 * (declared after .btn-sm, so it wins; Skyline needs no compound selector). */
.btn-icon-first {
  padding-left: 22rpx;
}

.btn-primary {
  background-color: var(--accent);
  color: var(--accent-ink);
}

.btn-secondary {
  background-color: var(--surface);
  border: 1px solid var(--rule);
  color: var(--accent);
}

.btn-tonal {
  background-color: var(--accent-soft);
  color: var(--accent);
}

.btn-danger {
  background-color: transparent;
  border: 1px solid var(--danger);
  color: var(--danger);
}

.btn-disabled {
  opacity: 0.4;
}

/* Full-width buttons in forms keep a gap above. */
.btn-block {
  margin-top: 40rpx;
}

/* ---- icon buttons: a round target around one <t-icon> ---- */
.icon-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
}

.icon-btn-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}

.icon-btn-tonal {
  background-color: var(--accent-soft);
}

/* Working (e.g. audio loading): dimmed, still tappable. */
.icon-btn-busy {
  opacity: 0.45;
}

.icon-btn-off {
  opacity: 0.3;
}

/* ---- text links: quiet actions inside a line ---- */
.link {
  padding: 12rpx 0;
  color: var(--accent);
  font-size: 28rpx;
}

.link-strong {
  font-weight: 600;
}

.link-danger {
  color: var(--danger);
}

/* ---- rows: a trailing value and chevron ---- */
.row-trail {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

/* ---- progress ----
 * .meter: a rounded bar (width of .meter-fill set inline in %).
 * The 复习 ring is a conic gradient built in JS (lib/review-home.ts). */
.meter {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--rule);
}

.meter-fill {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--accent);
}

/* ---- marks: a ✓ / ✗ icon in front of a line of text ---- */
.mark-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.mark-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 48rpx;
}
