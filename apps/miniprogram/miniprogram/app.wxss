/*
 * The design system (see README "Design system").
 *
 * Paper-like and quiet: off-white ground (宣纸), ink text, one accent (主题色:
 * indigo by default); thin rules and whitespace instead of shadows. English
 * results use a serif, everything else the system font.
 *
 * Colours are CSS variables on the page root (`theme-light` / `theme-dark`
 * plus `accent-<accent>-<theme>`, resolved from the settings in
 * services/theme.ts) so they work the same under Skyline and WebView;
 * lib/palette.ts mirrors them for icons and gradients. Secondary text and
 * every accent meet 4.5:1 against the ground in both themes.
 *
 * Skyline limits shape the components below: a rounded box takes one border
 * colour for all four sides, there is no currentColor, and text glyphs such
 * as ▶︎ ✓ › turn into emoji on iOS. So icons are <t-icon> SVGs, never
 * characters, and shapes never rely on per-side border colours.
 */
.theme-light {
  --bg: #f7f5f0;
  --ink: #1d1c1a;
  --ink-soft: #46433d;
  --muted: #6f6a62;
  --rule: #e2ddd3;
  --accent: #2f3e7a;
  --accent-soft: rgba(47, 62, 122, 0.12);
  --accent-ink: #ffffff;
  --surface: #fffefb;
  --danger: #9c3426;
  --danger-soft: rgba(156, 52, 38, 0.1);
}

.theme-dark {
  --bg: #131312;
  --ink: #ebe8e1;
  --ink-soft: #c9c4ba;
  --muted: #8f8a80;
  --rule: #2c2b28;
  --accent: #9fb0ee;
  --accent-soft: rgba(159, 176, 238, 0.16);
  --accent-ink: #131312;
  --surface: #1c1c1a;
  --danger: #e59a8c;
  --danger-soft: rgba(229, 154, 140, 0.16);
}

/*
 * Accent colours (主题色): the page root carries `accent-<accent>-<theme>`
 * after `theme-<theme>` (services/theme.ts → `accentClass`). Declared after
 * the theme blocks, so they win; one flat class per pair, no compound
 * selectors. Light values from the design; dark ones keep ≥ 4.5:1 on the dark
 * ground. lib/palette.ts (ACCENT_COLORS) mirrors them.
 */
.accent-indigo-light {
  --accent: #2f3e7a;
  --accent-soft: rgba(47, 62, 122, 0.12);
  --accent-ink: #ffffff;
}

.accent-indigo-dark {
  --accent: #9fb0ee;
  --accent-soft: rgba(159, 176, 238, 0.16);
  --accent-ink: #131312;
}

.accent-pine-light {
  --accent: #2e5e46;
  --accent-soft: rgba(46, 94, 70, 0.12);
  --accent-ink: #ffffff;
}

.accent-pine-dark {
  --accent: #86c2a0;
  --accent-soft: rgba(134, 194, 160, 0.16);
  --accent-ink: #131312;
}

.accent-plum-light {
  --accent: #553c7b;
  --accent-soft: rgba(85, 60, 123, 0.12);
  --accent-ink: #ffffff;
}

.accent-plum-dark {
  --accent: #c2a6ec;
  --accent-soft: rgba(194, 166, 236, 0.16);
  --accent-ink: #131312;
}

.accent-ochre-light {
  --accent: #8a4b1f;
  --accent-soft: rgba(138, 75, 31, 0.12);
  --accent-ink: #ffffff;
}

.accent-ochre-dark {
  --accent: #e3a774;
  --accent-soft: rgba(227, 167, 116, 0.16);
  --accent-ink: #131312;
}

.accent-ink-light {
  --accent: #1d1c1a;
  --accent-soft: rgba(29, 28, 26, 0.12);
  --accent-ink: #ffffff;
}

.accent-ink-dark {
  --accent: #ebe8e1;
  --accent-soft: rgba(235, 232, 225, 0.16);
  --accent-ink: #131312;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
}

/* The scrolling area below the navigation bar. */
.body {
  flex: 1;
  height: 0;
}

.content {
  padding: 16rpx 40rpx 96rpx;
}

.serif {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
}

.muted {
  color: var(--muted);
}

.rule {
  height: 1px;
  background-color: var(--rule);
}

.error {
  display: block;
  margin-top: 16rpx;
  color: var(--danger);
  font-size: 28rpx;
}

.placeholder {
  color: var(--muted);
}

/* ---- type scale (README "Design system → Type") ----
 * The only text sizes a page uses (rpx; 2rpx = 1px). Nothing below 24rpx.
 *   .t-display   64  numbers that lead a card (18 张, streaks)
 *   .t-headword  56  a word or phrase as the subject of a page (serif)
 *   .t-title     40  the headline inside a page (a material's title)
 *   .t-heading   34  a section heading with weight (学习资料, 打印与导出)
 *   .t-reading   34  English to read: sentences, stories, examples (serif)
 *   .t-body      32  default text (rows, paragraphs) — the .page size
 *   .t-secondary 28  a second line: glosses, explanations, meta under a title
 *   .t-label     26  a group label above content (重点词, 在本句中), muted, weight 600
 *   .t-caption   24  dates, counts, hints, tags
 * Controls keep their own sizes: .btn 30, .btn-sm / .choice-chip / .seg-option 26. */
.t-display {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
}

.t-headword {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
}

.t-title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.t-heading {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.t-reading {
  font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
  font-size: 34rpx;
  line-height: 1.7;
}

.t-body {
  font-size: 32rpx;
  line-height: 1.6;
}

.t-secondary {
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.55;
}

.t-label {
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.t-caption {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
}

/* A section heading with a trailing action (全部 ›, 导出记录): one row, the action is a .link. */
.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
}

/* ---- press feedback ----
 * Every tappable view carries hover-class="pressed" (hover-stay-time 80), so a
 * tap visibly lands; Skyline has no :active on views. */
.pressed {
  opacity: 0.55;
}

/* ---- page states: loading, empty, error ----
 * <view class="state"><text class="state-text">…</text><view class="btn btn-secondary btn-sm">重试</view></view>
 * Loading uses .skel blocks shaped like the content, never a bare "加载中…" line. */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 96rpx 32rpx;
  text-align: center;
}

.state-text {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.state-error {
  color: var(--danger);
}

.skel {
  border-radius: 12rpx;
  background-color: var(--rule);
}

.skel-line {
  height: 28rpx;
  margin-bottom: 20rpx;
}

.skel-block {
  height: 160rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
}

/* ---- composer: the input area of 翻译 and 纠错 ----
 * One quiet surface: a slightly lighter (dark: lighter) panel with a hairline
 * border that turns indigo while typing. Input on top, a bar below with a
 * hint on the left and clear / mic / send on the right. No shadow. */
.composer {
  margin-top: 8rpx;
  padding: 24rpx 28rpx 20rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 28rpx;
}

.composer-focused {
  border-color: var(--accent);
}

.composer-input {
  width: 100%;
  min-height: 156rpx;
  font-size: 34rpx;
  line-height: 1.55;
  color: var(--ink);
}

.composer-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  margin-top: 12rpx;
}

.composer-hint {
  color: var(--muted);
  font-size: 24rpx;
}

.composer-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}

.hint {
  display: block;
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 26rpx;
}

/* ---- result area ---- */
.result {
  padding: 40rpx 8rpx 0;
}

.direction {
  display: block;
  margin-bottom: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.direction-flip {
  color: var(--accent);
}

.output {
  display: block;
  font-size: 36rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.output-en {
  font-size: 44rpx;
  line-height: 1.45;
}

.headline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
}

.head {
  margin-right: 20rpx;
  font-size: 56rpx;
  line-height: 1.3;
}

.ipa {
  color: var(--muted);
  font-size: 30rpx;
}

.gloss {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
}

.explanation {
  display: block;
  margin-top: 32rpx;
  color: var(--ink-soft);
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1px solid var(--rule);
}

/* ---- word diff (纠错) ---- */
.diff-delete {
  color: var(--muted);
  text-decoration: line-through;
}

.diff-insert {
  color: var(--accent);
  background-color: var(--accent-soft);
}

/* ---- lists (我的, 记录, 设备) ---- */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1px solid var(--rule);
}

.row-label {
  font-size: 32rpx;
}

.row-value {
  color: var(--muted);
  font-size: 28rpx;
}

.section-title {
  display: block;
  margin-top: 48rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.segmented {
  display: flex;
  flex-direction: row;
}

.segment {
  margin-left: 32rpx;
  color: var(--muted);
  font-size: 30rpx;
}

.segment-on {
  color: var(--accent);
  font-weight: 600;
}

.field {
  display: block;
  width: 100%;
  height: 96rpx;
  border-bottom: 1px solid var(--rule);
  color: var(--ink);
  font-size: 40rpx;
  letter-spacing: 8rpx;
}

.notice {
  display: block;
  margin-top: 32rpx;
  color: var(--ink-soft);
  font-size: 30rpx;
}

.empty {
  display: block;
  padding: 96rpx 0;
  color: var(--muted);
  text-align: center;
  font-size: 28rpx;
}

/* ---- buttons ----
 * One shape, the pill. Weights:
 *   .btn-primary    filled indigo — the one main action of a screen
 *   .btn-secondary  surface + hairline — other actions
 *   .btn-tonal      indigo tint — inline actions next to content (朗读, 复制)
 *   .btn-danger     danger hairline — destructive
 * Sizes: default 88rpx, .btn-sm 64rpx (inline), .btn-lg 96rpx (docked).
 * An icon goes first: <view class="btn btn-tonal btn-sm"><t-icon …/><text>朗读</text></view>.
 */
.btn {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-sm {
  gap: 8rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.btn-lg {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}

/* A small pill that starts with an icon: less padding on the icon side
 * (declared after .btn-sm, so it wins; Skyline needs no compound selector). */
.btn-icon-first {
  padding-left: 22rpx;
}

.btn-primary {
  background-color: var(--accent);
  color: var(--accent-ink);
}

.btn-secondary {
  background-color: var(--surface);
  border: 1px solid var(--rule);
  color: var(--accent);
}

.btn-tonal {
  background-color: var(--accent-soft);
  color: var(--accent);
}

.btn-danger {
  background-color: transparent;
  border: 1px solid var(--danger);
  color: var(--danger);
}

.btn-disabled {
  opacity: 0.4;
}

/* Full-width buttons in forms keep a gap above. */
.btn-block {
  margin-top: 40rpx;
}

/* ---- icon buttons: a round target around one <t-icon> ---- */
.icon-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
}

.icon-btn-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}

.icon-btn-tonal {
  background-color: var(--accent-soft);
}

.icon-btn-off {
  opacity: 0.3;
}

/* ---- text links: quiet actions inside a line ---- */
.link {
  padding: 12rpx 0;
  color: var(--accent);
  font-size: 28rpx;
}

.link-strong {
  font-weight: 600;
}

.link-danger {
  color: var(--danger);
}

/* ---- rows: a trailing value and chevron ---- */
.row-trail {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

/* A label with a hint line under it (settings rows). */
.row-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  gap: 4rpx;
  padding: 20rpx 24rpx 20rpx 0;
}

.row-hint {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ---- switch: drawn, so it follows the theme and accent (the native one does not) ----
 * <view class="switch {{on ? 'switch-on' : ''}}"><view class="knob {{on ? 'knob-on' : ''}}"></view></view>
 * inside a row with aria-role="switch" and aria-checked. */
.switch {
  position: relative;
  flex-shrink: 0;
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: var(--rule);
}

.switch-on {
  background-color: var(--accent);
}

.knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: var(--muted);
}

.knob-on {
  left: 40rpx;
  background-color: var(--accent-ink);
}

/* ---- progress ----
 * .meter: a rounded bar (width of .meter-fill set inline in %).
 * The 复习 ring is a conic gradient built in JS (lib/review-home.ts). */
.meter {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--rule);
}

.meter-fill {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--accent);
}

/* ---- marks: a ✓ / ✗ icon in front of a line of text ---- */
.mark-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.mark-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 48rpx;
}

/* ---- 学习 pieces (v3) ----
 * .card-surface   a surface panel with a hairline (a material, a settings group)
 * .label-tag      a small label (每日资料, 未读); -accent filled, -soft tinted, -plain text only, -danger,
 *                 -danger-soft danger on a danger tint (复习时忘了 2 次)
 * .choice-chip    a pill to pick (复习范围, 资料内容, 拓展方向); .choice-chip-on chosen; in a .choice-chips row
 * .tick           a checkbox: <view class="tick {{on ? 'tick-on' : ''}}"><t-icon wx:if="{{on}}" name="check" tone="accentInk" size="32" /></view>;
 *                 .tick-round for a round one (selecting materials)
 * .seg-control    a segmented control of .seg-option (+ .seg-option-on)
 * .bottom-bar     the docked action bar of a detail page (padding-bottom set inline with the safe area)
 * One border colour per rounded box (Skyline). */
.card-surface {
  padding: 28rpx 32rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 32rpx;
}

.label-tag {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  background-color: var(--rule);
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.label-tag-accent {
  background-color: var(--accent);
  color: var(--accent-ink);
}

.label-tag-soft {
  background-color: var(--accent-soft);
  color: var(--accent);
}

.label-tag-plain {
  background-color: transparent;
  color: var(--muted);
  font-weight: 400;
}

.label-tag-danger {
  background-color: transparent;
  color: var(--danger);
  font-weight: 400;
}

.label-tag-danger-soft {
  background-color: var(--danger-soft);
  color: var(--danger);
}

.choice-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.choice-chip {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border: 1px solid var(--rule);
  border-radius: 32rpx;
  background-color: var(--surface);
  color: var(--ink-soft);
  font-size: 26rpx;
}

.choice-chip-on {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--accent-ink);
}

.tick {
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid var(--muted);
  border-radius: 16rpx;
  background-color: var(--surface);
}

.tick-round {
  border-radius: 28rpx;
}

.tick-on {
  border-color: var(--accent);
  background-color: var(--accent);
}

.seg-control {
  display: flex;
  flex-direction: row;
  padding: 6rpx;
  border-radius: 24rpx;
  background-color: var(--rule);
}

.seg-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 18rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
}

.seg-option-on {
  background-color: var(--surface);
  color: var(--ink);
}

.bottom-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 40rpx;
  border-top: 1px solid var(--rule);
  background-color: var(--surface);
}
