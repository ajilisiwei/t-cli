<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="学习统计" back />
  <scroll-view class="body" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="content">
      <!-- Loading: the streak, the calendar and the bars. -->
      <view wx:if="{{loading && !loaded}}" aria-label="加载中">
        <view class="skel st-skel-streak" />
        <view class="skel skel-line st-skel-note" />
        <view class="skel skel-line st-skel-label" />
        <view class="skel st-skel-heatmap" />
        <view class="skel skel-line st-skel-label" />
        <view class="skel st-skel-bars" />
      </view>
      <view wx:if="{{errorText && !loaded && !loading}}" class="state">
        <text class="state-text state-error">{{errorText}}</text>
        <view class="btn btn-secondary btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onRetry" aria-role="button"><text>重试</text></view>
      </view>

      <block wx:if="{{loaded}}">
        <!-- 连续 N 天: the words and the number share a bottom edge (no baseline alignment across sizes). -->
        <view class="streak" aria-label="连续 {{streakDays}} 天">
          <text class="t-secondary">连续</text>
          <text class="t-display">{{streakDays}}</text>
          <text class="t-secondary">天</text>
        </view>
        <text class="t-caption streak-note">{{streakDays > 0 ? activeText : '今天查一个词或复习一张卡，就开始计算连续天数'}}</text>

        <view class="section-head st-section"><text class="t-label">日历</text></view>
        <view class="heatmap" aria-label="近 17 周每天的查询和复习，{{activeText}}">
          <view class="months">
            <text wx:for="{{months}}" wx:key="key" class="t-caption month" style="left: {{item.left}}rpx;">{{item.text}}</text>
          </view>
          <view class="grid">
            <view class="weekdays">
              <text wx:for="{{weekdays}}" wx:key="key" class="t-caption weekday">{{item.label}}</text>
            </view>
            <view wx:for="{{columns}}" wx:for-item="column" wx:for-index="col" wx:key="key" class="heat-col">
              <!-- A day shrinks while pressed (the shades are opacities, so .pressed would not show). -->
              <view
                wx:for="{{column.cells}}"
                wx:for-item="cell"
                wx:for-index="row"
                wx:key="date"
                class="heat-cell heat-{{cell.level}} {{cell.future ? 'heat-future' : ''}}"
                hover-class="{{cell.future ? 'none' : 'heat-pressed'}}"
                hover-stay-time="80"
                data-col="{{col}}"
                data-row="{{row}}"
                bindtap="onDay"
                aria-role="{{cell.future ? 'none' : 'button'}}"
                aria-label="{{cell.label}}"
              ></view>
            </view>
          </view>
        </view>
        <view class="heat-foot">
          <text class="t-secondary heat-selected">{{selected}}</text>
          <view class="legend" aria-hidden="true">
            <text class="t-caption legend-text">少</text>
            <view class="legend-cell heat-0"></view>
            <view class="legend-cell heat-1"></view>
            <view class="legend-cell heat-2"></view>
            <view class="legend-cell heat-3"></view>
            <view class="legend-cell heat-4"></view>
            <text class="t-caption legend-text">多</text>
          </view>
        </view>

        <view class="section-head st-section"><text class="t-label">保持率 · 近 12 周</text></view>
        <text class="t-body retention-summary">{{retentionText}}</text>
        <view class="bars">
          <view class="target" aria-hidden="true"></view>
          <text class="t-caption target-label" aria-hidden="true">90%</text>
          <view wx:for="{{bars}}" wx:key="weekStart" class="bar-slot" aria-label="{{item.label}}">
            <view class="bar-track">
              <text class="t-caption bar-mark">{{item.mark}}</text>
              <view wx:if="{{item.rate !== null}}" class="bar-fill" style="height: {{item.height * 1.5}}rpx;"></view>
              <view wx:else class="bar-none"></view>
            </view>
            <text class="t-caption bar-tick">{{item.tick}}</text>
          </view>
        </view>
        <text class="t-caption caption">横线是目标 90%。复习学过的卡片时，选「困难」「记得」「简单」都算记住。</text>

        <view class="section-head st-section"><text class="t-label">累计</text></view>
        <view class="totals">
          <view wx:for="{{totals}}" wx:key="label" class="total" aria-label="{{item.label}} {{item.value}}">
            <text class="t-title">{{item.value}}</text>
            <text class="t-caption">{{item.label}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
