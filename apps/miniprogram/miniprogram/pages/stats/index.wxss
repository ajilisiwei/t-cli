.failed {
  padding-top: 48rpx;
}

.streak {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding-top: 24rpx;
}

.streak-number {
  margin: 0 12rpx;
  font-size: 96rpx;
  line-height: 1.1;
}

.streak-label {
  color: var(--ink-soft);
  font-size: 30rpx;
}

.streak-note {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 26rpx;
}

/* ---- heatmap ----
 * Geometry mirrored in index.ts: the weekday column is 36rpx + 12rpx gap,
 * every week column a 30rpx cell + 6rpx gap. */
.heatmap {
  position: relative;
  margin-top: 16rpx;
}

.months {
  position: relative;
  height: 32rpx;
}

.month {
  position: absolute;
  top: 0;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.grid {
  display: flex;
  flex-direction: row;
  margin-top: 4rpx;
}

.weekdays {
  width: 36rpx;
  margin-right: 12rpx;
}

.weekday {
  display: block;
  height: 30rpx;
  margin-bottom: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 30rpx;
}

.heat-col {
  width: 30rpx;
  margin-right: 6rpx;
}

.heat-cell {
  width: 30rpx;
  height: 30rpx;
  margin-bottom: 6rpx;
  border-radius: 6rpx;
}

/* Shades of the accent; level 0 is a quiet tile, future days are blank. */
.heat-0 {
  background-color: var(--rule);
}

.heat-1 {
  background-color: var(--accent);
  opacity: 0.25;
}

.heat-2 {
  background-color: var(--accent);
  opacity: 0.45;
}

.heat-3 {
  background-color: var(--accent);
  opacity: 0.7;
}

.heat-4 {
  background-color: var(--accent);
}

.heat-future {
  background-color: transparent;
  opacity: 1;
}

.heat-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.heat-selected {
  color: var(--ink-soft);
  font-size: 26rpx;
}

.legend {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.legend-text {
  margin: 0 8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.legend-cell {
  width: 20rpx;
  height: 20rpx;
  margin-left: 4rpx;
  border-radius: 4rpx;
}

/* ---- retention bars ----
 * Bars are rate × 150rpx tall inside a 180rpx track (30rpx left for the
 * percent above); the 90% target line sits at 32rpx (ticks) + 135rpx. */
.retention-summary {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
}

.bars {
  position: relative;
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
  padding-left: 56rpx;
}

.target {
  position: absolute;
  left: 56rpx;
  right: 0;
  bottom: 167rpx;
  height: 1px;
  background-color: var(--muted);
  opacity: 0.5;
}

.target-label {
  position: absolute;
  left: 0;
  bottom: 152rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 30rpx;
}

.bar-slot {
  position: relative;
  z-index: 1;
  flex: 1;
}

.bar-track {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  height: 180rpx;
}

.bar-percent {
  padding: 0 2rpx;
  background-color: var(--bg);
  color: var(--muted);
  font-size: 18rpx;
  line-height: 28rpx;
}

.bar-fill {
  width: 26rpx;
  border-radius: 6rpx 6rpx 0 0;
  background-color: var(--accent);
}

.bar-none {
  width: 26rpx;
  height: 2rpx;
  background-color: var(--rule);
}

.bar-tick {
  display: block;
  height: 32rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
}

.caption {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---- totals ---- */
.totals {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}

.total {
  flex: 1;
  padding: 24rpx 0;
}

.total-value {
  display: block;
  font-size: 40rpx;
  line-height: 1.3;
}

.total-label {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
}
