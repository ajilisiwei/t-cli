/*
 * 学习统计. Type (.t-*), states and skeletons come from app.wxss; chart
 * labels are .t-caption (24rpx) with fixed line heights for the geometry
 * below. Chart marks (days, legend squares, bars) keep their small radii:
 * they are data, not boxes.
 */

/* ---- streak: 连续 N 天 on one bottom edge (flex-end, not baseline: Skyline) ---- */
.streak {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 12rpx;
  padding-top: 24rpx;
}

.streak-note {
  display: block;
  margin-top: 8rpx;
}

.st-section {
  margin-top: 32rpx;
}

/* ---- heatmap ----
 * Geometry mirrored in index.ts: the weekday column is 36rpx + 12rpx gap,
 * every week column a 30rpx cell + 6rpx gap. */
.heatmap {
  position: relative;
}

.months {
  position: relative;
  height: 32rpx;
}

.month {
  position: absolute;
  top: 0;
  line-height: 32rpx;
  white-space: nowrap;
}

.grid {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
}

.weekdays {
  width: 36rpx;
  margin-right: 12rpx;
}

.weekday {
  display: block;
  height: 30rpx;
  margin-bottom: 6rpx;
  line-height: 30rpx;
}

.heat-col {
  width: 30rpx;
  margin-right: 6rpx;
}

.heat-cell {
  width: 30rpx;
  height: 30rpx;
  margin-bottom: 6rpx;
  border-radius: 6rpx;
}

/* Press feedback for a day: a shrink (the shades below are opacities). */
.heat-pressed {
  transform: scale(0.8);
}

/* Shades of the accent; level 0 is a quiet tile, future days are blank. */
.heat-0 {
  background-color: var(--rule);
}

.heat-1 {
  background-color: var(--accent);
  opacity: 0.25;
}

.heat-2 {
  background-color: var(--accent);
  opacity: 0.45;
}

.heat-3 {
  background-color: var(--accent);
  opacity: 0.7;
}

.heat-4 {
  background-color: var(--accent);
}

.heat-future {
  background-color: transparent;
  opacity: 1;
}

.heat-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.heat-selected {
  flex: 1;
  min-width: 0;
}

.legend {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.legend-text {
  margin: 0 8rpx;
}

.legend-cell {
  width: 20rpx;
  height: 20rpx;
  margin-left: 4rpx;
  border-radius: 4rpx;
}

/* ---- retention bars ----
 * Bars are rate × 150rpx tall inside a 180rpx track (30rpx left for the
 * figure above); the 90% target line sits at 32rpx (ticks) + 135rpx. */
.retention-summary {
  display: block;
}

.bars {
  position: relative;
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
  padding-left: 56rpx;
}

.target {
  position: absolute;
  left: 56rpx;
  right: 0;
  bottom: 167rpx;
  height: 1px;
  background-color: var(--muted);
  opacity: 0.5;
}

.target-label {
  position: absolute;
  left: 0;
  bottom: 152rpx;
  line-height: 30rpx;
}

.bar-slot {
  position: relative;
  z-index: 1;
  flex: 1;
}

.bar-track {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  height: 180rpx;
}

/* The figure above a bar ("92", no %: it would not fit a bar's width). */
.bar-mark {
  background-color: var(--bg);
  line-height: 28rpx;
}

.bar-fill {
  width: 26rpx;
  border-radius: 6rpx 6rpx 0 0;
  background-color: var(--accent);
}

.bar-none {
  width: 26rpx;
  height: 2rpx;
  background-color: var(--rule);
}

.bar-tick {
  display: block;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
}

.caption {
  display: block;
  margin-top: 12rpx;
}

/* ---- totals ---- */
.totals {
  display: flex;
  flex-direction: row;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}

.total {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
}

/* ---- loading ---- */
.st-skel-streak {
  width: 280rpx;
  height: 76rpx;
  margin-top: 24rpx;
}

.st-skel-note {
  width: 360rpx;
  margin-top: 16rpx;
}

.st-skel-label {
  width: 120rpx;
  margin-top: 48rpx;
}

.st-skel-heatmap {
  height: 292rpx;
  border-radius: 24rpx;
}

.st-skel-bars {
  height: 212rpx;
  border-radius: 24rpx;
}
