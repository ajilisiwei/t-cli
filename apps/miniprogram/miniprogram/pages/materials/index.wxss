/*
 * 周期资料. Type (.t-*) and the shared pieces (card-surface, label-tag,
 * choice-chip, bottom-bar, marks, section-head, state, skel) live in
 * app.wxss; this file lays out the sections. The root is positioned so the
 * export sheet can sit over the page.
 */
.mt-page {
  position: relative;
  overflow: hidden;
}

.mt-head {
  padding-top: 8rpx;
}

.mt-title {
  display: block;
  margin-top: 12rpx;
}

.mt-cells {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 24rpx;
}

.mt-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
}

/* ---- sections ---- */
.mt-section {
  margin-top: 40rpx;
}

.mt-sub {
  margin-top: 24rpx;
}

.mt-block {
  display: block;
}

.mt-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.mt-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* A word or phrase in a list: serif at the reading size, tighter than a paragraph. */
.mt-word {
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.4;
}

.mt-headline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

/* Why the word is here: a quiet tag under the meaning (tone from the label-tag variants). */
.mt-why {
  align-self: flex-start;
  font-weight: 400;
}

.mt-example {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
}

/* ---- 情景短文 ---- */
.mt-story {
  margin-top: 40rpx;
}

.mt-story-text {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.mt-story-word {
  color: var(--accent);
  font-weight: 600;
}

.mt-story-zh {
  display: block;
  margin-top: 16rpx;
}

/* ---- 练习 ---- */
.mt-question {
  padding: 16rpx 0 24rpx;
}

.mt-question-text {
  display: block;
  color: var(--ink);
}

.mt-question-zh {
  display: block;
  margin-top: 8rpx;
}

.mt-blank {
  text-decoration: underline;
}

.mt-blank-idle {
  color: var(--muted);
}

.mt-blank-right {
  color: var(--accent);
}

.mt-blank-wrong {
  color: var(--danger);
}

.mt-choices {
  margin-top: 16rpx;
}

.mt-chip-wrong {
  border-color: var(--danger);
  color: var(--danger);
}

.mt-reveal {
  margin-top: 16rpx;
  padding: 24rpx 32rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
}

.mt-reveal-answer {
  margin-top: 8rpx;
}

.mt-reveal-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--accent);
}

.mt-answer {
  flex: 1;
  color: var(--ink);
}

/* ---- 语法与易错 ---- */
.mt-mistake {
  margin-top: 16rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
}

.mt-mistake-title {
  display: block;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.mt-wrong {
  flex: 1;
  color: var(--muted);
  text-decoration: line-through;
}

.mt-right {
  flex: 1;
  color: var(--ink);
}

.mt-note {
  display: block;
  margin-top: 8rpx;
}

/* ---- loading ---- */
.mt-skel-caption {
  width: 360rpx;
}

.mt-skel-title {
  width: 80%;
  height: 54rpx;
  margin-top: 12rpx;
}

.mt-skel-cell {
  flex: 1;
  height: 104rpx;
  border-radius: 24rpx;
}

.mt-skel-label {
  width: 160rpx;
  margin-top: 48rpx;
}

/* ---- bottom bar ---- */
.mt-grow {
  flex: 1;
}
