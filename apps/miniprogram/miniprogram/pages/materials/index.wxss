/*
 * 周期资料. Shared pieces (card-surface, label-tag, choice-chip, bottom-bar,
 * marks, .headline) live in app.wxss; this file lays out the sections. The
 * root is positioned so the export sheet can sit over the page.
 */
.mt-page {
  position: relative;
  overflow: hidden;
}

.mt-head {
  padding-top: 8rpx;
}

.mt-head-line {
  display: block;
  color: var(--muted);
  font-size: 26rpx;
}

.mt-title {
  display: block;
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.35;
}

.mt-cells {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 24rpx;
}

.mt-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
}

.mt-cell-value {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 600;
}

.mt-cell-label {
  color: var(--muted);
  font-size: 24rpx;
}

/* ---- sections ---- */
.mt-section {
  margin-top: 52rpx;
}

.mt-section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.mt-section-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
}

/* A title inside a row of its own (no extra gap under it). */
.mt-flat {
  margin-bottom: 0;
}

.mt-sub {
  margin-top: 40rpx;
}

.mt-score {
  color: var(--muted);
  font-size: 24rpx;
}

.mt-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--rule);
}

.mt-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.mt-word {
  margin-right: 16rpx;
  color: var(--ink);
  font-size: 38rpx;
  line-height: 1.3;
}

.mt-phrase {
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.4;
}

.mt-ipa {
  color: var(--muted);
  font-size: 26rpx;
}

.mt-gloss {
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.5;
}

/* Why the word is here: a quiet tag under the meaning (tone from the label-tag variants). */
.mt-why {
  align-self: flex-start;
  margin-top: 4rpx;
  font-weight: 400;
}

.mt-example {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.mt-example-zh {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---- 情景短文 ---- */
.mt-story {
  margin-top: 52rpx;
}

.mt-story-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mt-story-text {
  display: block;
  margin-top: 20rpx;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.mt-story-word {
  color: var(--accent);
  font-weight: 600;
}

.mt-story-zh {
  display: block;
  margin-top: 20rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

/* ---- 练习 ---- */
.mt-question {
  padding: 20rpx 0;
}

.mt-question-text {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
  line-height: 1.6;
}

.mt-blank {
  text-decoration: underline;
}

.mt-blank-idle {
  color: var(--muted);
}

.mt-blank-right {
  color: var(--accent);
}

.mt-blank-wrong {
  color: var(--danger);
}

.mt-choices {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.mt-chip-wrong {
  border-color: var(--danger);
  color: var(--danger);
}

.mt-reveal {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.mt-reveal-prompt {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
}

.mt-reveal-answer {
  margin-top: 8rpx;
}

.mt-reveal-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 24rpx;
}

.mt-answer {
  flex: 1;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
}

/* ---- 语法与易错 ---- */
.mt-mistake {
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
}

.mt-mistake-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.mt-wrong {
  flex: 1;
  color: var(--muted);
  font-size: 30rpx;
  line-height: 1.6;
  text-decoration: line-through;
}

.mt-right {
  flex: 1;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
}

.mt-note {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---- empty / error ---- */
.mt-none {
  padding: 96rpx 16rpx;
  text-align: center;
}

.mt-none-title {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
}

.mt-none-note {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.mt-retry {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 24rpx;
}

.mt-grow {
  flex: 1;
}
