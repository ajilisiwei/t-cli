/* 每日材料. Shared tokens, rows and .headline live in app.wxss. */
.mat-head {
  flex-shrink: 0;
  padding: 0 40rpx;
  background-color: var(--bg);
}

.date-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
}

.date-label {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

/* Full-width hairline under the tabs (the head's padding is cancelled). */
.tabs {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin: 0 -40rpx;
  padding: 0 40rpx;
  border-bottom: 1px solid var(--rule);
}

.tab {
  padding: 16rpx 4rpx 18rpx;
  color: var(--muted);
  font-size: 28rpx;
  border-bottom: 4rpx solid transparent;
}

.tab-on {
  color: var(--ink);
  font-weight: 600;
  border-bottom-color: var(--accent);
}

/* ---- 概览 ---- */
.stats {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 24rpx 0 16rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  width: 50%;
  padding: 20rpx 0;
}

.stat-value {
  color: var(--ink);
  font-size: 60rpx;
  line-height: 1.2;
}

.stat-label {
  color: var(--muted);
  font-size: 24rpx;
}

/* ---- entries: one word / phrase / rule each, hairlines between ---- */
.entry {
  padding: 36rpx 0 32rpx;
  border-bottom: 1px solid var(--rule);
}

.entry-head {
  margin-right: 16rpx;
  color: var(--ink);
  font-size: 52rpx;
  line-height: 1.3;
}

.entry-phrase {
  margin-right: 16rpx;
  color: var(--ink);
  font-size: 38rpx;
  line-height: 1.4;
}

.entry-ipa {
  margin-right: 8rpx;
  color: var(--muted);
  font-size: 28rpx;
}

/* Round 朗读 button; centred on the headword line (the row aligns baselines). */
.play {
  align-self: center;
  margin-left: 8rpx;
}

.meaning {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 12rpx;
}

.pos {
  margin-right: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-style: italic;
}

.meaning-zh {
  color: var(--ink);
  font-size: 32rpx;
}

.gloss-line {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 30rpx;
  line-height: 1.6;
}

.register {
  color: var(--muted);
  font-size: 26rpx;
}

.example {
  margin-top: 20rpx;
  padding-left: 20rpx;
  border-left: 2px solid var(--rule);
}

.example-en {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
}

.example-zh {
  display: block;
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.tag {
  color: var(--accent);
  font-size: 22rpx;
}

.detail {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.detail-key {
  flex-shrink: 0;
  width: 80rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.9;
}

.detail-list {
  flex: 1;
}

.detail-value {
  display: block;
  flex: 1;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-note {
  color: var(--muted);
  font-size: 24rpx;
}

.alternative {
  margin-top: 12rpx;
}

.alternative-en {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
}

.alternative-note {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
}

/* ---- 语法 ---- */
.grammar-title {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.pair {
  margin-top: 12rpx;
}

.pair-text {
  flex: 1;
  color: var(--ink);
  font-size: 32rpx;
  line-height: 1.5;
}

.pair-text-wrong {
  color: var(--muted);
  text-decoration: line-through;
}

.rule-text {
  display: block;
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

.exercise-title {
  display: block;
  margin-top: 28rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.exercise {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.exercise-text {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
}

.exercise-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 24rpx;
}

/* ---- 短文 ---- */
.story {
  padding: 36rpx 0;
}

.story-title {
  display: block;
  color: var(--ink);
  font-size: 44rpx;
  line-height: 1.3;
}

.story-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 20rpx;
}

.story-text {
  display: block;
  margin-top: 24rpx;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.story-word {
  color: var(--accent);
}

.story-zh {
  display: block;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--rule);
  color: var(--ink-soft);
  font-size: 30rpx;
  line-height: 1.8;
}

/* ---- empty / error ---- */
.none {
  padding: 96rpx 16rpx;
  text-align: center;
}

.none-title {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
}

.none-note {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.retry {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 24rpx;
}
