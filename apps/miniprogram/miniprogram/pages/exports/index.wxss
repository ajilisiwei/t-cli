/* 导出记录. Buttons and links come from app.wxss. */
.ex-row {
  padding: 28rpx 0;
  border-bottom: 1px solid var(--rule);
}

.ex-file {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.ex-badge {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  width: 72rpx;
  height: 88rpx;
  padding-bottom: 10rpx;
  border-radius: 12rpx;
  background-color: var(--danger);
}

.ex-badge-text {
  color: var(--bg);
  font-size: 20rpx;
  font-weight: 700;
}

.ex-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ex-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.ex-meta {
  color: var(--muted);
  font-size: 24rpx;
}

.ex-left {
  color: var(--muted);
  font-size: 22rpx;
}

.ex-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-left: 96rpx;
}

.ex-remove {
  margin-left: auto;
}

.ex-empty {
  padding: 120rpx 16rpx;
  text-align: center;
}

.ex-empty-title {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
}

.ex-empty-note {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.ex-note {
  display: block;
  margin-top: 32rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.7;
}
