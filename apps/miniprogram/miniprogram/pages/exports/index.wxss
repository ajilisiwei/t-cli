/* 导出记录. Type (.t-*), buttons, links and states come from app.wxss. */
.ex-row {
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.ex-file {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

/* A drawn file icon: a danger page with PDF at its foot. */
.ex-badge {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  width: 72rpx;
  height: 88rpx;
  padding-bottom: 8rpx;
  border-radius: 12rpx;
  background-color: var(--danger);
}

.ex-badge-text {
  color: var(--bg);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.ex-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ex-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
  font-weight: 600;
}

/* The actions line up under the name (badge 72 + gap 24). */
.ex-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-left: 96rpx;
}

/* 删除: a link with a 64rpx target, at the end of the row. */
.ex-remove {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  margin-left: auto;
  padding: 0 0 0 24rpx;
}

.ex-note {
  display: block;
  margin-top: 32rpx;
}
