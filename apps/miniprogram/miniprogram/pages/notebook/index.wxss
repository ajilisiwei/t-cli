/* Layout only: type comes from the scale (.t-*), the card, segmented
 * control, chips, tags, buttons, stars and states from app.wxss and the
 * components (README "Design system"). Every rounded box has one border
 * colour. */

/* ---- summary card (.card-surface) ---- */
.summary {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 8rpx;
}

/* Number and caption differ in size: bottom-aligned, not on a baseline
 * (Skyline). Both at line height 1.2, the caption lifted 8rpx so the two
 * baselines meet. */
.summary-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 12rpx;
}

.summary-caption {
  padding-bottom: 8rpx;
  color: var(--muted);
  line-height: 1.2;
}

/* Hairline gaps between the segments are drawing, not layout spacing. */
.mastery {
  display: flex;
  flex-direction: row;
  gap: 4rpx;
  height: 16rpx;
}

/* Each segment rounds itself (a pill): no overflow clipping needed. */
.mastery-seg {
  height: 16rpx;
  min-width: 8rpx;
  border-radius: 8rpx;
}

.mastery-new {
  background-color: var(--rule);
}

.mastery-learning {
  background-color: var(--accent);
  opacity: 0.55;
}

.mastery-mastered {
  background-color: var(--accent);
}

.legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.legend-text {
  color: var(--ink-soft);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

/* ---- type tabs (.seg-control) and star filters (.choice-chip) ---- */
.nb-tabs {
  margin-top: 24rpx;
}

.filters {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* Five chips and 最近加入 share one line on a 360 px screen: tighter than the default chip. */
.nb-star-chips {
  gap: 12rpx;
}

.nb-star-chip {
  gap: 8rpx;
  padding: 0 16rpx;
}

.order {
  flex-shrink: 0;
}

/* ---- rows ---- */
.note {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.note-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* Words and phrases at the reading size, sentences at body size. */
.note-text {
  display: block;
  font-size: 34rpx;
  line-height: 1.4;
  word-break: break-word;
}

.note-text-sentence {
  font-size: 32rpx;
  line-height: 1.6;
}

.note-gloss {
  display: block;
}

.note-gloss-full {
  white-space: pre-wrap;
  word-break: break-word;
}

/* Words and phrases: one line; sentences: two (Skyline also reads max-lines). */
.clamp-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tags {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

/* Centred on the first line of a word (34rpx × 1.4). */
.note-stars {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  padding-top: 12rpx;
}

/* ---- expanded row ---- */
.note-edit {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 12rpx;
}

/* The first star's target starts at the text's edge. */
.note-stars-edit {
  display: flex;
  flex-direction: row;
  margin-left: -14rpx;
}

.note-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.list-end {
  display: block;
  padding: 48rpx 0;
  text-align: center;
}

/* ---- skeletons (app.wxss .skel), breathing while a page loads ---- */
.skel-pulse {
  animation-name: nb-pulse;
  animation-duration: 900ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes nb-pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.45;
  }
}

/* The total's height (64rpx type). */
.nb-skel-total {
  width: 40%;
  height: 64rpx;
}

.nb-skel-bar {
  height: 16rpx;
}

.nb-skel-text {
  width: 56%;
  height: 34rpx;
  margin-bottom: 8rpx;
}

.nb-skel-gloss {
  width: 40%;
  height: 28rpx;
  margin-bottom: 8rpx;
}

/* The size of a .label-tag. */
.nb-skel-tag {
  width: 80rpx;
  height: 40rpx;
}

/* Four 24rpx stars. */
.nb-skel-stars {
  flex-shrink: 0;
  width: 96rpx;
  height: 24rpx;
  margin-top: 12rpx;
}
