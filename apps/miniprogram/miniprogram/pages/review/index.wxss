/*
 * 学习 home. Type (.t-*), the pieces (card-surface, label-tag, choice-chip,
 * meter, btn, section-head, state, skel) come from app.wxss; this file only
 * lays them out. The root is positioned so the export sheet can sit over the
 * page.
 */
.lh-page {
  position: relative;
  overflow: hidden;
}

/* ---- 今天的复习 ---- */
.lh-today {
  margin-top: 8rpx;
}

.lh-today-top {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.lh-today-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* The count and its unit share a bottom edge (flex-end, not baseline: Skyline). */
.lh-due {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 12rpx;
}

.lh-done {
  padding-bottom: 8rpx;
  color: var(--ink-soft);
}

.lh-meter {
  margin-top: 24rpx;
  overflow: hidden;
}

.lh-chips {
  margin-top: 24rpx;
}

/* A scope with nothing due: visible for its count, not selectable. */
.lh-chip-off {
  opacity: 0.4;
}

.lh-start {
  margin-top: 24rpx;
}

.lh-calm {
  display: block;
  margin-top: 24rpx;
}

/* States inside a card or a section: the shared .state, with less air. */
.lh-state {
  padding: 32rpx 0;
}

/* ---- skeletons: the card's caption, count, meter and button ---- */
.lh-skel-caption {
  width: 280rpx;
}

.lh-skel-due {
  width: 200rpx;
  height: 64rpx;
}

.lh-skel-meter {
  height: 8rpx;
  margin-top: 24rpx;
}

.lh-skel-start {
  height: 96rpx;
  margin-top: 24rpx;
  border-radius: 48rpx;
}

.lh-skel-material {
  height: 240rpx;
  border-radius: 32rpx;
}

/* ---- section heads ---- */
.lh-section {
  margin-top: 40rpx;
  margin-bottom: 8rpx;
}

/* 全部 › / 导出记录 ›: a link with an icon, a 64rpx target. */
.lh-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  padding: 0;
}

/* ---- 学习资料 ---- */
.lh-material {
  margin-bottom: 24rpx;
}

.lh-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.lh-status {
  margin-left: auto;
}

.lh-material-body {
  display: flex;
  flex-direction: column;
}

.lh-material-title {
  display: block;
  margin-top: 16rpx;
}

.lh-material-line {
  display: block;
  margin-top: 8rpx;
}

/* An extension's first reason, under its title: one line. */
.lh-one-line {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lh-material-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.lh-grow {
  flex: 1;
}

.lh-report {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  background-color: var(--accent-soft);
}

.lh-tag-surface {
  background-color: var(--surface);
}

.lh-report-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
}

/* ---- 打印与导出 ---- */
.lh-tiles {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.lh-tile {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 32rpx;
}

.lh-tile-off {
  opacity: 0.4;
}

.lh-tile-label {
  color: var(--ink);
  font-weight: 600;
}

/* ---- 学习计划 ---- */
.lh-plan {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-top: 1px solid var(--rule);
}

.lh-plan-text {
  flex: 1;
}
