/*
 * 学习 home. The pieces (card-surface, label-tag, choice-chip, meter, btn)
 * come from app.wxss; this file lays them out. The root is positioned so the
 * export sheet can sit over the page.
 */
.lh-page {
  position: relative;
  overflow: hidden;
}

/* ---- 今天的复习 ---- */
.lh-today {
  margin-top: 8rpx;
}

.lh-today-top {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

.lh-today-left {
  display: flex;
  flex-direction: column;
}

.lh-caption {
  color: var(--muted);
  font-size: 26rpx;
}

.lh-due {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.lh-due-n {
  color: var(--ink);
  font-size: 72rpx;
  line-height: 1.15;
}

.lh-due-unit {
  color: var(--ink-soft);
  font-size: 28rpx;
}

.lh-done {
  padding-bottom: 12rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.lh-meter {
  margin-top: 24rpx;
  overflow: hidden;
}

.lh-chips {
  margin-top: 28rpx;
}

.lh-start {
  margin-top: 28rpx;
}

.lh-calm {
  display: block;
  margin-top: 24rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

.lh-error {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.lh-error-text {
  margin-top: 0;
}

/* ---- section heads ---- */
.lh-section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 48rpx;
  margin-bottom: 16rpx;
}

.lh-section-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.lh-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  min-height: 72rpx;
  color: var(--accent);
  font-size: 28rpx;
}

/* ---- 学习资料 ---- */
.lh-material {
  margin-bottom: 20rpx;
}

.lh-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.lh-when {
  color: var(--muted);
  font-size: 24rpx;
}

.lh-status {
  margin-left: auto;
}

.lh-material-body {
  display: flex;
  flex-direction: column;
}

.lh-material-title {
  display: block;
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* An extension's first reason, under its title: one line. */
.lh-material-subtitle {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.5;
}

.lh-material-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.5;
}

.lh-material-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.lh-grow {
  flex: 1;
}

.lh-report {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background-color: var(--accent-soft);
}

.lh-tag-surface {
  background-color: var(--surface);
}

.lh-report-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
  font-size: 28rpx;
}

.lh-empty {
  display: block;
  padding: 24rpx 0;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

/* ---- 打印与导出 ---- */
.lh-tiles {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.lh-tile {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 20rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 28rpx;
}

.lh-tile-off {
  opacity: 0.5;
}

.lh-tile-label {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.lh-tile-hint {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---- 学习计划 ---- */
.lh-plan {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-top: 1px solid var(--rule);
}

.lh-plan-text {
  flex: 1;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.6;
}
