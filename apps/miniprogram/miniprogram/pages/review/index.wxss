/* 复习 home: one ring, one button. Shared tokens and rows live in app.wxss. */
.today {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 8rpx;
}

.today-date {
  color: var(--muted);
  font-size: 26rpx;
}

.today-streak {
  color: var(--ink-soft);
  font-size: 26rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 56rpx;
}

/*
 * Progress ring: a conic gradient (inline, lib/review-home.ts ringStyle) under
 * a disc in the page colour, plus a dot at each end for round caps. The end
 * dot sits at 12 o'clock on a full-size arm rotated to the angle.
 */
.ring {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  border-radius: 160rpx;
}

.ring-hole {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 292rpx;
  height: 292rpx;
  border-radius: 146rpx;
  background-color: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-arm {
  position: absolute;
  top: 0;
  left: 0;
  width: 320rpx;
  height: 320rpx;
}

.ring-cap {
  position: absolute;
  top: 0;
  left: 153rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background-color: var(--accent);
}

.ring-caption {
  color: var(--muted);
  font-size: 24rpx;
}

.ring-done {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 88rpx;
  line-height: 1.1;
}

.ring-total {
  color: var(--muted);
  font-size: 26rpx;
}

.hero-meta {
  display: block;
  margin-top: 36rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  text-align: center;
}

.start {
  align-self: stretch;
  margin-top: 40rpx;
}

.calm {
  padding: 96rpx 24rpx 80rpx;
  text-align: center;
}

.calm-title {
  display: block;
  color: var(--ink);
  font-size: 34rpx;
}

.calm-note {
  display: block;
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.load-error {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.load-error-text {
  margin-top: 0;
}

/* The latest 每日材料: the one panel on the page. */
.material {
  padding: 28rpx 32rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
}

.material-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.material-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.material-counts {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.material-story {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.material-note {
  color: var(--muted);
  line-height: 1.7;
}

.links {
  margin-top: 32rpx;
}
