<view class="page lh-page theme-{{theme}} {{accentClass}}">
  <nav-bar title="学习" />
  <scroll-view
    class="body"
    scroll-y
    type="list"
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="{{theme === 'dark' ? 'white' : 'black'}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="content">
      <!-- 今天的复习 -->
      <view class="card-surface lh-today" aria-label="今天的复习">
        <block wx:if="{{loaded}}">
          <view class="lh-today-top">
            <view class="lh-today-left">
              <text class="t-caption">{{today.caption}}</text>
              <!-- Number and unit sit on one bottom line (no baseline alignment across sizes). -->
              <view class="lh-due">
                <text class="t-display">{{today.due}}</text>
                <text class="t-secondary">{{today.dueUnit}}</text>
              </view>
            </view>
            <text class="t-caption lh-done">已完成 {{today.done}}</text>
          </view>
          <view class="meter lh-meter" aria-role="img" aria-label="{{today.meterLabel}}">
            <view class="meter-fill" style="width: {{today.meterPct}}%;" />
          </view>
          <block wx:if="{{today.mode === 'due'}}">
            <view wx:if="{{scopeAvailable}}" class="choice-chips lh-chips" aria-role="radiogroup" aria-label="复习范围">
              <view
                wx:for="{{scopes}}"
                wx:key="id"
                class="choice-chip {{item.checked ? 'choice-chip-on' : ''}} {{item.off ? 'lh-chip-off' : ''}}"
                hover-class="{{item.off ? 'none' : 'pressed'}}"
                hover-stay-time="80"
                data-id="{{item.id}}"
                data-off="{{item.off}}"
                bindtap="onScope"
                aria-role="radio"
                aria-checked="{{item.checked}}"
                aria-disabled="{{item.off}}"
              >
                <text>{{item.label}}</text>
              </view>
            </view>
            <view
              class="btn btn-primary btn-lg lh-start {{startText ? '' : 'btn-disabled'}}"
              hover-class="{{startText ? 'pressed' : 'none'}}"
              hover-stay-time="80"
              bindtap="onStart"
              aria-role="button"
              aria-disabled="{{!startText}}"
            >
              <text>{{startText || '这个范围今天没有要复习的'}}</text>
            </view>
          </block>
          <text wx:elif="{{today.mode === 'finished'}}" class="t-secondary lh-calm">今天的复习完成了</text>
          <text wx:else class="t-secondary lh-calm">今天没有要复习的卡片。查过的词句，第二天早上会整理成复习卡。</text>
        </block>
        <!-- Loading: the card's own shape. -->
        <view wx:elif="{{!errorText}}" aria-label="加载中">
          <view class="skel skel-line lh-skel-caption" />
          <view class="skel lh-skel-due" />
          <view class="skel lh-skel-meter" />
          <view class="skel lh-skel-start" />
        </view>
        <view wx:if="{{errorText}}" class="state lh-state">
          <text class="state-text state-error">{{errorText}}</text>
          <view class="btn btn-secondary btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onRetry" aria-role="button"><text>重试</text></view>
        </view>
      </view>

      <!-- 学习资料 -->
      <view class="section-head lh-section">
        <text class="t-heading">学习资料</text>
        <view class="link lh-more" hover-class="pressed" hover-stay-time="80" bindtap="onAllMaterials" aria-role="button" aria-label="全部学习资料">
          <text>全部</text>
          <t-icon name="chevron-right" tone="accent" size="28" />
        </view>
      </view>
      <block wx:if="{{!loaded && !errorText}}">
        <view class="skel skel-block lh-skel-material" />
        <view class="skel skel-block lh-skel-material" />
      </block>
      <block wx:for="{{materials}}" wx:key="key">
        <view wx:if="{{item.layout === 'full'}}" class="card-surface lh-material">
          <view class="lh-tags">
            <text class="label-tag">{{item.kindLabel}}</text>
            <text class="t-caption">{{item.dateLabel}}</text>
            <text wx:if="{{item.status}}" class="label-tag lh-status {{item.statusTone === 'accent' ? 'label-tag-soft' : 'label-tag-plain'}}">{{item.status}}</text>
          </view>
          <view
            class="lh-material-body"
            hover-class="pressed"
            hover-stay-time="80"
            data-url="{{item.url}}"
            bindtap="onOpen"
            aria-role="button"
            aria-label="{{item.title}}"
          >
            <text class="t-heading lh-material-title">{{item.title}}</text>
            <text wx:if="{{item.meta}}" class="t-secondary lh-material-line">{{item.meta}}</text>
          </view>
          <view class="lh-material-actions">
            <view class="btn btn-tonal lh-grow" hover-class="pressed" hover-stay-time="80" data-url="{{item.url}}" bindtap="onOpen" aria-role="button"><text>开始学习</text></view>
            <view
              class="btn btn-secondary btn-icon-first"
              hover-class="pressed"
              hover-stay-time="80"
              data-key="{{item.key}}"
              bindtap="onMaterialPdf"
              aria-role="button"
              aria-label="导出 PDF"
            >
              <t-icon name="printer" tone="accent" size="32" />
              <text>PDF</text>
            </view>
          </view>
        </view>
        <view
          wx:elif="{{item.layout === 'card'}}"
          class="card-surface lh-material"
          hover-class="pressed"
          hover-stay-time="80"
          data-url="{{item.url}}"
          bindtap="onOpen"
          aria-role="button"
          aria-label="{{item.title}}"
        >
          <view class="lh-tags">
            <text class="label-tag label-tag-accent">{{item.kindLabel}}</text>
            <text class="t-caption">{{item.dateLabel}}</text>
            <text wx:if="{{item.status}}" class="label-tag lh-status {{item.statusTone === 'accent' ? 'label-tag-soft' : 'label-tag-plain'}}">{{item.status}}</text>
          </view>
          <text class="t-heading lh-material-title">{{item.title}}</text>
          <text wx:if="{{item.subtitle}}" class="t-secondary lh-material-line lh-one-line" max-lines="1" overflow="ellipsis">{{item.subtitle}}</text>
          <text wx:if="{{item.meta}}" class="t-secondary lh-material-line">{{item.meta}}</text>
        </view>
        <view
          wx:else
          class="lh-report"
          hover-class="pressed"
          hover-stay-time="80"
          data-url="{{item.url}}"
          bindtap="onOpen"
          aria-role="button"
          aria-label="周报：{{item.title}}"
        >
          <text class="label-tag lh-tag-surface">{{item.kindLabel}}</text>
          <text class="t-secondary lh-report-text">{{item.dateLabel}} · {{item.title}}</text>
          <t-icon name="chevron-right" tone="muted" size="28" />
        </view>
      </block>
      <view wx:if="{{materialsEmpty}}" class="state lh-state">
        <text class="state-text">{{materialsEmpty}}</text>
      </view>

      <!-- 打印与导出 -->
      <view class="section-head lh-section">
        <text class="t-heading">打印与导出</text>
        <view class="link lh-more" hover-class="pressed" hover-stay-time="80" bindtap="onExports" aria-role="button" aria-label="导出记录">
          <text>导出记录{{exportCount ? ' ' + exportCount : ''}}</text>
          <t-icon name="chevron-right" tone="accent" size="28" />
        </view>
      </view>
      <view class="lh-tiles">
        <view
          wx:for="{{tiles}}"
          wx:key="id"
          class="lh-tile {{item.off ? 'lh-tile-off' : ''}}"
          hover-class="{{item.off ? 'none' : 'pressed'}}"
          hover-stay-time="80"
          data-id="{{item.id}}"
          data-off="{{item.off}}"
          bindtap="onTile"
          aria-role="button"
          aria-disabled="{{item.off}}"
          aria-label="{{item.label}}，{{item.hint}}"
        >
          <t-icon name="{{item.icon}}" tone="accent" size="44" />
          <text class="t-secondary lh-tile-label">{{item.label}}</text>
          <text class="t-caption">{{item.hint}}</text>
        </view>
      </view>

      <!-- 学习计划 -->
      <view class="lh-plan" hover-class="pressed" hover-stay-time="80" bindtap="onPlan" aria-role="button" aria-label="学习计划：{{planText}}">
        <text class="t-secondary lh-plan-text">学习计划：{{planText}}</text>
        <t-icon name="chevron-right" tone="muted" size="28" />
      </view>
    </view>
  </scroll-view>

  <t-export-sheet open="{{exportOpen}}" input="{{exportInput}}" bind:close="onExportClose" bind:exported="onExported" />
</view>
