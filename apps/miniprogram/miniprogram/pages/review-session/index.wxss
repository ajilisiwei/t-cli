/*
 * 复习卡. Type (.t-*), buttons, states and skeletons live in app.wxss; no
 * shadows, hairlines only. The card faces keep page classes because their
 * size depends on the face (Chinese, English, a headword): scale sizes only.
 */
.session {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 0;
}

.session-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 40rpx 0;
}

.progress {
  margin: 16rpx 40rpx 0;
}

/* The card fills the space between the progress line and the dock. */
.card-area {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 0;
  padding: 24rpx 40rpx 8rpx;
}

/* The card follows the finger while dragging; otherwise it eases back. */
.card {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  padding: 32rpx 40rpx 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 32rpx;
  transition: transform 180ms ease-out;
}

.card-dragging {
  transition: none;
}

.card-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 40rpx;
}

.card-intent-left {
  color: var(--danger);
}

.card-intent-right {
  color: var(--accent);
}

.card-body {
  flex: 1;
  height: 0;
}

.face {
  margin-top: 24rpx;
}

/* A face: Chinese 34, English to read 40 (serif), a headword 56 (serif). */
.face-text {
  display: block;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.face-en {
  font-size: 40rpx;
  line-height: 1.4;
}

.face-head {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
}

.mark {
  color: var(--accent);
}

.ipa-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.face-ipa {
  color: var(--muted);
}

/* The 朗读 button when there is no IPA line to sit next to. */
.speak-line {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.face-sub {
  display: block;
  margin-top: 16rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.example {
  margin-top: 24rpx;
  padding-left: 24rpx;
  border-left: 2px solid var(--rule);
}

.example-en {
  display: block;
  color: var(--ink);
}

.example-zh {
  display: block;
  margin-top: 8rpx;
}

.face-back {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--rule);
}

.tap-hint {
  display: block;
  flex-shrink: 0;
  padding-top: 24rpx;
  text-align: center;
}

/* ---- dock: undo strip + grade buttons ---- */
.dock {
  flex-shrink: 0;
  padding-left: 40rpx;
  padding-right: 40rpx;
  background-color: var(--bg);
}

.undo-strip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

/* 撤销: a link with a 64rpx target. */
.undo-action {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 0 0 32rpx;
}

.gesture-hint {
  width: 100%;
  text-align: center;
}

.grades {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.grade {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 120rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
}

/* 记得 is the usual answer: the one tinted button. */
.grade-3 {
  background-color: var(--accent-soft);
  border-color: var(--accent);
}

/* A control label: the button size (30). */
.grade-label {
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.4;
}

.grade-label-1 {
  color: var(--danger);
}

.grade-label-3 {
  color: var(--accent);
  font-weight: 600;
}

/* ---- end screen ---- */
.end {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.end-title {
  text-align: center;
}

.end-sub {
  margin-top: 12rpx;
  text-align: center;
}

.stats {
  display: flex;
  flex-direction: row;
  align-self: stretch;
  margin-top: 64rpx;
  padding: 40rpx 0;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}

.stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* The figure and its unit share a bottom edge (flex-end, not baseline: Skyline). */
.stat-figure {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
}

/* ---- loading ---- */
.skel-head {
  width: 200rpx;
  margin: 8rpx 0 0;
}

.skel-progress {
  height: 8rpx;
}

.skel-card {
  flex: 1;
  border-radius: 32rpx;
}

.skel-answer {
  height: 96rpx;
  border-radius: 48rpx;
}
