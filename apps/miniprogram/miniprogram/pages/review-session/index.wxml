<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="复习" back />

  <view wx:if="{{phase === 'reviewing'}}" class="session">
    <view class="session-head">
      <text class="t-label">{{label}}</text>
      <text class="t-caption">{{position}} / {{total}}</text>
    </view>
    <view class="meter progress"><view class="meter-fill" style="width: {{progressPct}}%;" /></view>

    <view class="card-area">
      <!-- The front flips on a tap (dims while pressed); the back is a swipe surface, so it does not. -->
      <view
        class="card {{dragging ? 'card-dragging' : ''}}"
        hover-class="{{flipped ? 'none' : 'pressed'}}"
        hover-stay-time="80"
        style="transform: translateX({{dragX}}px) rotate({{dragTilt}}deg);"
        bindtap="onCardTap"
        bindlongpress="onLongPress"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
        aria-role="button"
        aria-label="{{flipped ? '复习卡' : '翻面'}}"
      >
        <view class="card-top">
          <text class="t-caption">{{flipped ? '' : prompt}}</text>
          <text wx:if="{{dragIntent === 'left'}}" class="t-label card-intent-left">忘记</text>
          <text wx:elif="{{dragIntent === 'right'}}" class="t-label card-intent-right">记得</text>
        </view>

        <!-- A long back scrolls inside the card; the card itself always fills the space. -->
        <scroll-view class="card-body" scroll-y type="list" show-scrollbar="{{false}}">
          <view class="face">
            <!-- One line on purpose: whitespace inside <text> is rendered. -->
            <text class="face-text {{front.serif ? 'serif face-en' : ''}} {{front.headword ? 'face-head' : ''}}"><text wx:for="{{front.segments}}" wx:key="index" class="{{item.mark ? 'mark' : ''}}">{{item.text}}</text></text>
            <view wx:if="{{front.ipa}}" class="ipa-row">
              <text class="t-secondary face-ipa">/{{front.ipa}}/</text>
              <view
                wx:if="{{flipped && speakSlot === 'front'}}"
                class="icon-btn icon-btn-sm icon-btn-tonal"
                hover-class="pressed"
                hover-stay-time="80"
                catchtap="onSpeak"
                aria-role="button"
                aria-label="{{speakPhase === 'idle' ? '朗读' : '停止朗读'}}"
              >
                <t-speak-icon phase="{{speakPhase}}" tone="accent" size="30" />
              </view>
            </view>
            <text wx:if="{{front.sub}}" class="t-secondary face-sub {{front.subSerif ? 'serif' : ''}}">{{front.sub}}</text>
            <view wx:if="{{front.exampleEn}}" class="example">
              <text class="t-body serif example-en">{{front.exampleEn}}</text>
              <text wx:if="{{front.exampleZh}}" class="t-caption example-zh">{{front.exampleZh}}</text>
            </view>
          </view>

          <view wx:if="{{flipped}}" class="face face-back">
            <text class="face-text {{back.serif ? 'serif face-en' : ''}} {{back.headword ? 'face-head' : ''}}"><text wx:for="{{back.segments}}" wx:key="index" class="{{item.mark ? 'mark' : ''}}">{{item.text}}</text></text>
            <view wx:if="{{back.ipa}}" class="ipa-row">
              <text class="t-secondary face-ipa">/{{back.ipa}}/</text>
              <view
                wx:if="{{speakSlot === 'back'}}"
                class="icon-btn icon-btn-sm icon-btn-tonal"
                hover-class="pressed"
                hover-stay-time="80"
                catchtap="onSpeak"
                aria-role="button"
                aria-label="{{speakPhase === 'idle' ? '朗读' : '停止朗读'}}"
              >
                <t-speak-icon phase="{{speakPhase}}" tone="accent" size="30" />
              </view>
            </view>
            <text wx:if="{{back.sub}}" class="t-secondary face-sub {{back.subSerif ? 'serif' : ''}}">{{back.sub}}</text>
            <view wx:if="{{back.exampleEn}}" class="example">
              <text class="t-body serif example-en">{{back.exampleEn}}</text>
              <text wx:if="{{back.exampleZh}}" class="t-caption example-zh">{{back.exampleZh}}</text>
            </view>
            <view wx:if="{{speakSlot === 'line'}}" class="speak-line">
              <view
                class="icon-btn icon-btn-sm icon-btn-tonal"
                hover-class="pressed"
                hover-stay-time="80"
                catchtap="onSpeak"
                aria-role="button"
                aria-label="{{speakPhase === 'idle' ? '朗读' : '停止朗读'}}"
              >
                <t-speak-icon phase="{{speakPhase}}" tone="accent" size="30" />
              </view>
            </view>
          </view>
        </scroll-view>

        <text wx:if="{{!flipped}}" class="t-caption tap-hint">轻点翻面 · 长按报错</text>
      </view>
    </view>

    <view class="dock" style="padding-bottom: {{safeBottom + 16}}px;">
      <view class="undo-strip">
        <block wx:if="{{undoLabel}}">
          <text class="t-secondary">{{undoLabel}}</text>
          <view class="link link-strong undo-action" hover-class="pressed" hover-stay-time="80" bindtap="onUndo" aria-role="button"><text>{{undoing ? '撤销中…' : '撤销'}}</text></view>
        </block>
        <text wx:elif="{{showGestureHint}}" class="t-caption gesture-hint">左滑 忘记 · 右滑 记得</text>
      </view>
      <view wx:if="{{flipped}}" class="grades">
        <view
          wx:for="{{buttons}}"
          wx:key="rating"
          class="grade grade-{{item.rating}}"
          hover-class="pressed"
          hover-stay-time="80"
          data-rating="{{item.rating}}"
          bindtap="onRate"
          aria-role="button"
          aria-label="{{item.label}}，{{item.interval}}后再见"
        >
          <text class="grade-label grade-label-{{item.rating}}">{{item.label}}</text>
          <text class="t-caption">{{item.interval}}</text>
        </view>
      </view>
      <view wx:else class="btn btn-secondary btn-lg" hover-class="pressed" hover-stay-time="80" bindtap="onReveal" aria-role="button"><text>显示答案</text></view>
    </view>
  </view>

  <view wx:elif="{{phase === 'done'}}" class="session">
    <view class="end">
      <text class="t-title end-title">复习完成</text>
      <text wx:if="{{stats.reviewed > 0}}" class="t-secondary end-sub">这一轮复习了 {{stats.reviewed}} 张</text>
      <text wx:else class="t-secondary end-sub">这一轮没有复习卡片</text>
      <view wx:if="{{stats.reviewed > 0}}" class="stats">
        <view wx:for="{{stats.items}}" wx:key="label" class="stat">
          <!-- Number and unit share a bottom edge (no baseline alignment across sizes). -->
          <view class="stat-figure">
            <text class="t-display">{{item.value}}</text>
            <text class="t-secondary">{{item.unit}}</text>
          </view>
          <text class="t-caption">{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="dock" style="padding-bottom: {{safeBottom + 16}}px;">
      <view class="undo-strip">
        <block wx:if="{{undoLabel}}">
          <text class="t-secondary">{{undoLabel}}</text>
          <view class="link link-strong undo-action" hover-class="pressed" hover-stay-time="80" bindtap="onUndo" aria-role="button"><text>{{undoing ? '撤销中…' : '撤销'}}</text></view>
        </block>
      </view>
      <view class="btn btn-primary btn-lg" hover-class="pressed" hover-stay-time="80" bindtap="onFinish" aria-role="button"><text>完成</text></view>
    </view>
  </view>

  <view wx:elif="{{phase === 'empty'}}" class="session">
    <view class="end">
      <text class="t-title end-title">{{emptyTitle}}</text>
      <text class="t-secondary end-sub">刚复习过的卡会按间隔再回来</text>
    </view>
    <view class="dock" style="padding-bottom: {{safeBottom + 16}}px;">
      <view class="btn btn-secondary btn-lg" hover-class="pressed" hover-stay-time="80" bindtap="onFinish" aria-role="button"><text>返回</text></view>
    </view>
  </view>

  <view wx:elif="{{phase === 'error'}}" class="session">
    <view class="end">
      <view class="state">
        <text class="state-text state-error">{{errorText}}</text>
        <view class="btn btn-secondary btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onRetry" aria-role="button"><text>重试</text></view>
      </view>
    </view>
  </view>

  <!-- Loading: the session's shape (count line, progress, card, the answer button). -->
  <view wx:else class="session" aria-label="加载中">
    <view class="session-head">
      <view class="skel skel-line skel-head" />
    </view>
    <view class="skel progress skel-progress" />
    <view class="card-area">
      <view class="skel skel-card" />
    </view>
    <view class="dock" style="padding-bottom: {{safeBottom + 16}}px;">
      <view class="undo-strip" />
      <view class="skel skel-answer" />
    </view>
  </view>
</view>
