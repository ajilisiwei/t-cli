/* Layout only; the pieces come from app.wxss (README "Design system"). */

/* A settings group's heading: 32rpx plus .section-head's own room keeps groups ~48rpx apart. */
.group-head {
  margin-top: 32rpx;
}

/* ---- preview: a card in the previewed theme (colours inline: it may show the other theme) ---- */
.preview {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 8rpx;
  padding: 28rpx 32rpx 32rpx;
  border: 1px solid var(--rule);
  border-radius: 32rpx;
}

.preview-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* 浅色 / 深色: a small segmented control; its options share the width. */
.preview-seg {
  width: 240rpx;
}

/* The word and its IPA differ in font and size: centred, never baseline (Skyline). */
.preview-headline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 24rpx;
}

.preview-line {
  display: block;
}

.preview-pos {
  font-style: italic;
}

.preview-mark {
  font-weight: 600;
}

.preview-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.preview-glyph {
  width: 32rpx;
  height: 32rpx;
}

/* ---- 跟随时间 ---- */
.panel {
  margin-top: 24rpx;
}

/* The bar sits under the 现在 label (a caption: 24rpx × 1.4); the marker's line crosses it. */
.day-bar-box {
  position: relative;
  height: 72rpx;
}

.day-bar {
  position: absolute;
  left: 0;
  right: 0;
  top: 32rpx;
  display: flex;
  flex-direction: row;
  height: 24rpx;
  border: 1px solid var(--rule);
  border-radius: 12rpx;
  overflow: hidden;
}

.day-segment {
  height: 100%;
}

/* The marker is centred on its `left` by a negative margin of half its width. */
.now {
  position: absolute;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 64rpx;
  margin-left: -32rpx;
}

.now-label {
  color: var(--accent);
  font-weight: 600;
}

.now-line {
  width: 4rpx;
  height: 36rpx;
  background-color: var(--accent);
}

.day-scale {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

/* The last row in the card: the card's edge is its divider. */
.row-last {
  border-bottom-width: 0;
}

.hint-text {
  display: block;
  margin-top: 16rpx;
}

/* ---- 固定为: a segmented control at the end of its row ---- */
.fixed {
  margin-top: 16rpx;
}

.fixed-seg {
  width: 280rpx;
}

/* ---- 字号 ---- */
.row-off {
  opacity: 0.4;
}

.steps {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

/* A 36 px round target; px so it keeps its size on every screen. */
.step-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid var(--rule);
  border-radius: 18px;
  background-color: var(--surface);
  color: var(--accent);
}

.step-btn-off {
  opacity: 0.4;
}

/* The two A's show small and large type: the scale's 26 and 40. */
.step-a-small {
  font-size: 26rpx;
}

.step-a-large {
  font-size: 40rpx;
}

.dots {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: var(--rule);
}

.dot-on {
  background-color: var(--accent);
}
