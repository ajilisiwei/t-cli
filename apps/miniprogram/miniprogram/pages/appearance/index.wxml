<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="外观" back />
  <scroll-view class="body" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="content">
      <view class="preview" style="{{cardStyle}}" aria-label="预览">
        <view class="preview-head">
          <text class="preview-name" style="{{mutedStyle}}">{{previewName}}</text>
          <view class="chips" style="{{softStyle}}">
            <view
              wx:for="{{previewChips}}"
              wx:key="value"
              class="chip {{item.on ? 'chip-on' : ''}}"
              style="{{item.on ? cardStyle : ''}}"
              data-value="{{item.value}}"
              bindtap="onPreview"
              aria-role="button"
              aria-pressed="{{item.on}}"
              aria-label="预览{{item.label}}"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
        <view class="preview-headline">
          <text class="serif preview-word" style="{{wordStyle}}">concise</text>
          <text class="preview-ipa" style="{{mutedStyle}}">/kənˈsaɪs/</text>
        </view>
        <text class="preview-line" style="{{bodyStyle}}"><text class="serif preview-pos" style="{{mutedStyle}}">adj.</text>　简洁的；简明的；简要的</text>
        <text class="serif preview-line" style="{{bodyStyle}}">Keep your answers <text class="preview-mark" style="{{accentStyle}}">concise</text> and to the point.</text>
        <view class="preview-actions">
          <view class="preview-icon" style="{{softStyle}}"><image class="preview-glyph" src="{{speakerIcon}}" mode="aspectFit" /></view>
          <view class="preview-icon" style="{{softStyle}}"><image class="preview-glyph" src="{{bookmarkIcon}}" mode="aspectFit" /></view>
        </view>
      </view>

      <text class="section-title">什么时候切换</text>
      <view class="mode-tabs" aria-role="radiogroup" aria-label="深浅模式">
        <view
          wx:for="{{modes}}"
          wx:key="value"
          class="mode-tab {{item.on ? 'mode-tab-on' : ''}}"
          data-mode="{{item.value}}"
          bindtap="onMode"
          aria-role="radio"
          aria-checked="{{item.on}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{mode === 'time'}}" class="panel">
        <view class="day-bar-box" aria-label="浅色 {{dayStartLabel}} 到 {{nightStartLabel}}，其余时间深色">
          <view class="day-bar">
            <view wx:for="{{barSegments}}" wx:key="index" class="day-segment" style="{{item.style}}"></view>
          </view>
          <view class="now" style="{{nowStyle}}">
            <text class="now-label">现在</text>
            <view class="now-line"></view>
          </view>
        </view>
        <view class="day-scale">
          <text>0:00</text>
          <text>12:00</text>
          <text>24:00</text>
        </view>
        <picker mode="time" value="{{dayStart}}" bindchange="onDayStart">
          <view class="row panel-row" aria-role="button" aria-label="浅色开始：{{dayStartLabel}}">
            <text class="row-label">浅色开始</text>
            <view class="row-trail">
              <text class="row-value">{{dayStartLabel}}</text>
              <t-icon name="chevron-right" tone="muted" size="32" />
            </view>
          </view>
        </picker>
        <picker mode="time" value="{{nightStart}}" bindchange="onNightStart">
          <view class="row panel-row panel-row-last" aria-role="button" aria-label="深色开始：{{nightStartLabel}}">
            <text class="row-label">深色开始</text>
            <view class="row-trail">
              <text class="row-value">{{nightStartLabel}}</text>
              <t-icon name="chevron-right" tone="muted" size="32" />
            </view>
          </view>
        </picker>
        <text class="hint-text">到点自动切换。两个时间相同时全天浅色。</text>
      </view>
      <text wx:if="{{mode === 'system'}}" class="hint-text">跟随手机的深色模式：手机是浅色时用浅色，是深色时用深色。</text>
      <view wx:if="{{mode === 'fixed'}}">
        <view class="row">
          <text class="row-label">固定为</text>
          <view class="segmented" aria-role="radiogroup" aria-label="固定为">
            <view
              wx:for="{{fixedOptions}}"
              wx:key="value"
              class="segment {{item.on ? 'segment-on' : ''}}"
              data-value="{{item.value}}"
              bindtap="onFixed"
              aria-role="radio"
              aria-checked="{{item.on}}"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
        <text class="hint-text">始终使用这一种，不随手机或时间变化。</text>
      </view>

      <text class="section-title">阅读模式</text>
      <view class="row" bindtap="onReading" aria-role="switch" aria-checked="{{readingMode}}" aria-label="阅读模式">
        <view class="row-text">
          <text class="row-label">阅读模式</text>
          <text class="row-hint">每日短文、单词详情：大字、宽行距、隐藏多余按钮</text>
        </view>
        <view class="switch {{readingMode ? 'switch-on' : ''}}"><view class="knob {{readingMode ? 'knob-on' : ''}}"></view></view>
      </view>
      <view class="row {{readingMode ? '' : 'row-off'}}" aria-disabled="{{!readingMode}}">
        <text class="row-label">字号</text>
        <view class="steps">
          <view
            class="step-btn {{canShrink ? '' : 'step-btn-off'}}"
            data-delta="-1"
            bindtap="onFontStep"
            aria-role="button"
            aria-label="字号变小"
            aria-disabled="{{!canShrink}}"
          >
            <text class="step-a-small">A</text>
          </view>
          <view class="dots" aria-label="{{fontStepText}}">
            <view wx:for="{{fontDots}}" wx:key="n" class="dot {{item.on ? 'dot-on' : ''}}"></view>
          </view>
          <view
            class="step-btn {{canGrow ? '' : 'step-btn-off'}}"
            data-delta="1"
            bindtap="onFontStep"
            aria-role="button"
            aria-label="字号变大"
            aria-disabled="{{!canGrow}}"
          >
            <text class="step-a-large">A</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
