<view class="page theme-{{theme}}">
  <nav-bar title="纠错" />
  <scroll-view class="body" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="content">
      <view class="composer {{focused ? 'composer-focused' : ''}}">
        <textarea
          class="composer-input serif"
          value="{{input}}"
          focus="{{focus}}"
          auto-height
          maxlength="2000"
          confirm-type="send"
          show-confirm-bar="{{false}}"
          adjust-position
          placeholder="输入英文句子"
          placeholder-class="placeholder"
          bindinput="onInput"
          bindconfirm="onSubmit"
          bindfocus="onFocus"
          bindblur="onBlur"
        />
        <view class="composer-bar">
          <text wx:if="{{!input}}" class="composer-hint">标出改动，给出更地道的说法</text>
          <view class="composer-actions">
            <view wx:if="{{input}}" class="icon-btn" bindtap="onClear" aria-role="button" aria-label="清空">
              <t-icon name="close" tone="muted" size="32" />
            </view>
            <view
              wx:if="{{voiceEnabled}}"
              class="icon-btn {{recording ? 'icon-btn-tonal' : ''}}"
              bindtouchstart="onMicStart"
              bindtouchend="onMicEnd"
              bindtouchcancel="onMicEnd"
              aria-role="button"
              aria-label="按住说英文"
            >
              <t-icon name="mic" tone="{{recording ? 'accent' : 'muted'}}" size="36" />
            </view>
            <view class="btn btn-primary btn-sm {{input ? '' : 'btn-disabled'}}" bindtap="onSend" aria-role="button" aria-label="纠错">
              <text>纠错</text>
            </view>
          </view>
        </view>
        <text wx:if="{{recording}}" class="hint">正在听英文，松开即纠错</text>
      </view>

      <view wx:if="{{notEnglish}}" class="result">
        <text class="notice">纠错只支持英文</text>
        <view class="btn btn-secondary btn-block" bindtap="onGoTranslate" aria-role="button"><text>去翻译</text></view>
      </view>

      <view wx:elif="{{status !== 'idle'}}" class="result">
        <!-- One line on purpose: whitespace inside <text> is rendered. -->
        <text wx:if="{{corrected}}" class="output output-en serif" user-select><text wx:for="{{segments}}" wx:key="index" class="diff-{{item.op}}">{{item.text}}</text></text>
        <text wx:elif="{{pending}}" class="output output-en serif">{{pending}}</text>
        <text wx:if="{{unchanged}}" class="direction">没有需要修改的地方</text>

        <text wx:if="{{explanation}}" class="explanation" user-select>{{explanation}}</text>

        <text wx:if="{{status === 'waiting'}}" class="muted">检查中…</text>
        <text wx:if="{{status === 'stopped'}}" class="muted">已停止</text>
        <text wx:if="{{errorText}}" class="error">{{errorText}}</text>

        <view class="actions">
          <view wx:if="{{busy}}" class="btn btn-tonal btn-sm btn-icon-first" bindtap="onStop" aria-role="button">
            <t-icon name="stop" tone="accent" size="32" />
            <text>停止</text>
          </view>
          <block wx:else>
            <view class="btn btn-tonal btn-sm btn-icon-first {{corrected ? '' : 'btn-disabled'}}" bindtap="onCopyCorrected" aria-role="button">
              <t-icon name="copy" tone="accent" size="32" />
              <text>复制修改后句子</text>
            </view>
            <view class="btn btn-tonal btn-sm btn-icon-first {{canSpeak ? '' : 'btn-disabled'}}" bindtap="onSpeak" aria-role="button">
              <t-icon name="speaker" tone="accent" size="32" />
              <text>朗读</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
