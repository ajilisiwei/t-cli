<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="词库" back />
  <view class="filters">
    <view class="search {{searchFocused ? 'search-focused' : ''}}">
      <t-icon name="search" tone="muted" size="30" />
      <input
        class="search-input"
        type="text"
        confirm-type="search"
        maxlength="64"
        placeholder="搜索单词、句型、语法"
        placeholder-class="placeholder"
        aria-label="搜索词库"
        value="{{query}}"
        bindinput="onQueryInput"
        bindconfirm="onQueryConfirm"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
      />
      <view wx:if="{{query}}" class="icon-btn icon-btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onClearQuery" aria-role="button" aria-label="清空搜索">
        <t-icon name="close" tone="muted" size="28" />
      </view>
    </view>
    <view class="choice-chips lb-chips">
      <view
        wx:for="{{typeChips}}"
        wx:key="value"
        class="choice-chip {{item.value === typeValue ? 'choice-chip-on' : ''}}"
        hover-class="pressed"
        hover-stay-time="80"
        data-value="{{item.value}}"
        bindtap="onTypeChip"
        aria-role="button"
        aria-label="类型 {{item.label}}{{item.value === typeValue ? '，已选' : ''}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
    <view class="choice-chips lb-chips">
      <view
        wx:for="{{levelChips}}"
        wx:key="value"
        class="choice-chip {{item.value === levelValue ? 'choice-chip-on' : ''}}"
        hover-class="pressed"
        hover-stay-time="80"
        data-value="{{item.value}}"
        bindtap="onLevelChip"
        aria-role="button"
        aria-label="熟练度 {{item.label}}{{item.value === levelValue ? '，已选' : ''}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <scroll-view
    class="body"
    scroll-y
    type="list"
    show-scrollbar="{{false}}"
    lower-threshold="240"
    bindscrolltolower="onLoadMore"
    refresher-enabled
    refresher-default-style="{{theme === 'dark' ? 'white' : 'black'}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="content">
      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="unit"
        hover-class="pressed"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="onOpen"
        aria-role="button"
        aria-label="{{item.display}}，{{item.meta}}，{{item.levelLabel}}"
      >
        <view class="unit-main">
          <text class="serif unit-display">{{item.display}}</text>
          <text class="t-caption unit-meta">{{item.meta}}</text>
        </view>
        <text class="label-tag {{item.level === 'learning' ? 'label-tag-soft' : (item.level === 'mastered' ? 'label-tag-accent' : '')}}">{{item.levelLabel}}</text>
      </view>

      <!-- First load: rows shaped like units. Loading more: one row at the end. -->
      <view wx:if="{{loading && !refreshing}}" aria-label="加载中">
        <view wx:for="{{rows.length === 0 ? [1, 2, 3, 4, 5] : [1]}}" wx:key="*this" class="unit">
          <view class="unit-main">
            <view class="skel skel-line skel-pulse lb-skel-title" />
            <view class="skel skel-line skel-pulse lb-skel-meta" />
          </view>
          <view class="skel skel-pulse lb-skel-tag" />
        </view>
      </view>

      <view wx:if="{{errorText}}" class="state">
        <text class="state-text state-error">{{errorText}}</text>
        <view class="btn btn-secondary btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onRetry" aria-role="button"><text>重试</text></view>
      </view>
      <view wx:elif="{{loaded && rows.length === 0 && !loading}}" class="state">
        <text class="state-text">{{emptyText}}</text>
      </view>
      <text wx:elif="{{loaded && rows.length > 0 && !hasMore && !loading}}" class="t-caption list-end">共 {{rows.length}} 个</text>
    </view>
  </scroll-view>
</view>
