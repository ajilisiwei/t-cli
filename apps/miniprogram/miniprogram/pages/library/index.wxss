/* Search and chips stay above the scrolling list. Chips, tags, states and
 * type come from app.wxss (README "Design system"); this file lays out. */
.filters {
  flex-shrink: 0;
  padding: 8rpx 40rpx 24rpx;
  border-bottom: 1px solid var(--rule);
}

/* The same search pill as 查询记录. */
.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 8rpx 0 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 36rpx;
}

.search-focused {
  border-color: var(--accent);
}

.search-input {
  flex: 1;
  height: 72rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.lb-chips {
  margin-top: 16rpx;
}

/* ---- rows ---- */
.unit {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.unit-main {
  flex: 1;
  min-width: 0;
}

/* A unit's name: English to read, a step under the reading size's line height. */
.unit-display {
  display: block;
  font-size: 34rpx;
  line-height: 1.4;
  word-break: break-word;
}

.unit-meta {
  display: block;
  margin-top: 8rpx;
}

/* ---- skeleton rows (app.wxss .skel), breathing while a page loads ---- */
.skel-pulse {
  animation-name: lb-pulse;
  animation-duration: 900ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes lb-pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.45;
  }
}

.lb-skel-title {
  width: 56%;
  height: 34rpx;
  margin-bottom: 16rpx;
}

.lb-skel-meta {
  width: 32%;
  height: 24rpx;
  margin-bottom: 0;
}

/* The size of a .label-tag. */
.lb-skel-tag {
  flex-shrink: 0;
  width: 80rpx;
  height: 40rpx;
}

.list-end {
  display: block;
  padding: 48rpx 0;
  text-align: center;
}
