/* Layout only: type comes from the scale (.t-*), buttons, icons, stars,
 * states and the card from app.wxss and the components (README "Design
 * system"). Rounded boxes use one border colour; rows that mix fonts or
 * sizes are centred or top-aligned, never on a baseline (Skyline). */

.wd-headword {
  display: block;
  word-break: break-word;
}

/* ---- skeleton (app.wxss .skel), breathing while the lookup runs ---- */
.wd-skeleton {
  display: flex;
  flex-direction: column;
  padding-top: 16rpx;
}

.wd-skel-head {
  margin-bottom: 24rpx;
}

.skel-pulse {
  animation-name: wd-pulse;
  animation-duration: 900ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes wd-pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.45;
  }
}

.wd-skel-context {
  margin-top: 8rpx;
  border-radius: 32rpx;
}

.wd-w40 {
  width: 40%;
}

.wd-w64 {
  width: 64%;
}

.wd-w72 {
  width: 72%;
}

/* ---- header ---- */
.header {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 16rpx;
}

.head-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.headword-main {
  flex: 1;
  min-width: 0;
}

.ipa-line {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 32rpx;
}

.ipa-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.save-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

/* The page's main action: a larger round target (pill: half its height). */
.save-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}

/* ---- sections: a .section-head label, then rows 16rpx apart ---- */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

/* 在本句中: a tinted card */
.context {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 48rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background-color: var(--accent-soft);
}

.context-title {
  color: var(--accent);
}

.context-sentence {
  color: var(--ink-soft);
  word-break: break-word;
}

.context-hit {
  color: var(--accent);
  font-weight: 600;
}

/* Label, phrase (serif) and gloss differ in font and size: centred. */
.context-phrase {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.context-phrase-label {
  color: var(--accent);
}

.context-phrase-text {
  color: var(--ink);
}

/* 释义 */
.sense {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* Part of speech (serif) and gloss share size and line height: top-aligned. */
.sense-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.pos {
  flex-shrink: 0;
  color: var(--muted);
  font-style: italic;
}

.sense-gloss {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.sense-def {
  color: var(--muted);
}

/* 词形变化: two columns, each cell a label over its form. Label and form side
 * by side broke on Skyline: a long label ("present participle") left the form
 * no room, and the baseline-aligned form was drawn over the next row. */
.forms {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.form {
  display: flex;
  flex-direction: column;
  width: 50%;
  padding: 8rpx 24rpx 8rpx 0;
  box-sizing: border-box;
}

.form-label {
  word-break: break-word;
}

.form-value {
  word-break: break-word;
}

/* 常用搭配 (option B): the phrase over its gloss, bookmark on the right */
.colloc {
  display: flex;
  flex-direction: column;
}

.colloc-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.colloc-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  word-break: break-word;
}

.colloc-save {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
}

/* The first star's target starts at the text's edge. */
.colloc-stars {
  display: flex;
  flex-direction: row;
  margin-left: -14rpx;
}

/* 双语例句: a thin bar instead of a one-sided border */
.example {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.example-mark {
  flex-shrink: 0;
  align-self: stretch;
  width: 4rpx;
  border-radius: 2rpx;
  background-color: var(--rule);
}

.example-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.example-text {
  word-break: break-word;
}

/* 近义辨析: word (serif) and note share size and line height: top-aligned. */
.contrast {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.contrast-word {
  flex-shrink: 0;
  color: var(--ink);
  font-weight: 600;
}

.contrast-note {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.memory {
  word-break: break-word;
}

/* 我的记录 */
.record {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 48rpx;
}

.record-strong {
  color: var(--ink);
}

/* A text link at least 64rpx tall. */
.record-link {
  display: flex;
  flex-direction: row;
  align-self: flex-start;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
}

.footnote {
  display: block;
  margin-top: 32rpx;
  text-align: center;
}
