/* 周报. Type (.t-*), rows, states and skeletons come from app.wxss. */

/* Week navigation stays put under the navigation bar. */
.weeknav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 40rpx;
  border-bottom: 1px solid var(--rule);
}

/* ‹ 上一周 / 下一周 ›: an icon and a word, as one link (64rpx tall). */
.step {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 160rpx;
  min-height: 64rpx;
  color: var(--accent);
  font-size: 28rpx;
}

.step-right {
  justify-content: flex-end;
}

.step-off {
  color: var(--muted);
  opacity: 0.4;
}

.range {
  color: var(--ink);
  font-weight: 600;
}

.switching {
  opacity: 0.5;
}

/* An error over a report already shown: the shared state, with less air. */
.wk-state-inline {
  padding: 32rpx 0;
}

.summary {
  display: block;
  padding-top: 32rpx;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.totals {
  display: flex;
  flex-direction: row;
  margin-top: 40rpx;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}

.total {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
}

.wk-section {
  margin-top: 32rpx;
}

.retention {
  display: flex;
  flex-direction: row;
  gap: 64rpx;
}

.retention-cell {
  display: flex;
  flex-direction: column;
}

.retention-this {
  color: var(--accent);
}

.retention-last {
  color: var(--ink-soft);
}

.change {
  display: block;
  margin-top: 8rpx;
}

.ranked-text {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  padding: 16rpx 0;
  word-break: break-word;
}

/* ---- loading ---- */
.wk-skel-line {
  margin-top: 32rpx;
}

.wk-skel-short {
  width: 60%;
}

.wk-skel-totals {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-top: 40rpx;
}

.wk-skel-total {
  flex: 1;
  height: 104rpx;
}

.wk-skel-retention {
  width: 360rpx;
  height: 112rpx;
  margin-top: 48rpx;
}
