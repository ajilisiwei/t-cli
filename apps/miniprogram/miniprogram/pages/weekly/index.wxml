<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="周报" back />
  <view wx:if="{{loaded && !empty}}" class="weeknav">
    <view
      class="step {{hasPrevious ? '' : 'step-off'}}"
      hover-class="{{hasPrevious ? 'pressed' : 'none'}}"
      hover-stay-time="80"
      bindtap="onPrevious"
      aria-role="button"
      aria-label="上一周"
      aria-disabled="{{!hasPrevious}}"
    >
      <t-icon name="chevron-left" tone="accent" size="32" />
      <text>上一周</text>
    </view>
    <text class="t-secondary range">{{range}}</text>
    <view
      class="step step-right {{hasNext ? '' : 'step-off'}}"
      hover-class="{{hasNext ? 'pressed' : 'none'}}"
      hover-stay-time="80"
      bindtap="onNext"
      aria-role="button"
      aria-label="下一周"
      aria-disabled="{{!hasNext}}"
    >
      <text>下一周</text>
      <t-icon name="chevron-right" tone="accent" size="32" />
    </view>
  </view>

  <scroll-view class="body" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="content {{loading && loaded ? 'switching' : ''}}">
      <!-- Loading: the summary, the totals row and the retention figures. -->
      <view wx:if="{{loading && !loaded && !errorText}}" aria-label="加载中">
        <view class="skel skel-line wk-skel-line" />
        <view class="skel skel-line" />
        <view class="skel skel-line wk-skel-short" />
        <view class="wk-skel-totals">
          <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skel wk-skel-total" />
        </view>
        <view class="skel wk-skel-retention" />
      </view>

      <view wx:if="{{errorText}}" class="state {{loaded ? 'wk-state-inline' : ''}}">
        <text class="state-text state-error">{{errorText}}</text>
        <view class="btn btn-secondary btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onRetry" aria-role="button"><text>重试</text></view>
      </view>

      <view wx:if="{{loaded && empty}}" class="state">
        <text class="state-text">还没有周报</text>
        <text class="t-caption">每周整理一次：这一周查了多少、新学了哪些、复习记住了多少，以及最常错的语法和反复查的词。</text>
      </view>

      <block wx:if="{{loaded && !empty}}">
        <text wx:if="{{summary}}" class="t-body summary" user-select>{{summary}}</text>

        <view class="totals">
          <view wx:for="{{totals}}" wx:key="key" class="total" aria-label="{{item.value}} {{item.label}}">
            <text class="t-title">{{item.value}}</text>
            <text class="t-caption">{{item.label}}</text>
          </view>
        </view>

        <view class="section-head wk-section"><text class="t-label">保持率</text></view>
        <view class="retention" aria-label="保持率：本周 {{thisWeek}}，上周 {{lastWeek}}">
          <view class="retention-cell">
            <text class="t-display retention-this">{{thisWeek}}</text>
            <text class="t-caption">本周</text>
          </view>
          <view class="retention-cell">
            <text class="t-display retention-last">{{lastWeek}}</text>
            <text class="t-caption">上周</text>
          </view>
        </view>
        <text wx:if="{{change}}" class="t-secondary change">{{change}}</text>

        <block wx:if="{{topErrors.length > 0}}">
          <view class="section-head wk-section"><text class="t-label">最常错的语法</text></view>
          <view
            wx:for="{{topErrors}}"
            wx:key="key"
            class="row"
            hover-class="pressed"
            hover-stay-time="80"
            data-text="{{item.text}}"
            bindtap="onSearchGrammar"
            aria-role="button"
            aria-label="{{item.text}}，{{item.count}}"
          >
            <text class="t-body ranked-text">{{item.text}}</text>
            <text class="row-value">{{item.count}}</text>
          </view>
        </block>

        <block wx:if="{{topLookups.length > 0}}">
          <view class="section-head wk-section"><text class="t-label">反复查询</text></view>
          <view
            wx:for="{{topLookups}}"
            wx:key="key"
            class="row"
            hover-class="pressed"
            hover-stay-time="80"
            data-text="{{item.text}}"
            bindtap="onSearchLookup"
            aria-role="button"
            aria-label="{{item.text}}，{{item.count}}"
          >
            <text class="t-body serif ranked-text">{{item.text}}</text>
            <text class="row-value">{{item.count}}</text>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>
</view>
