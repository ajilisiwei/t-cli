<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="我的" />
  <scroll-view class="body" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="content">
      <view class="row" bindtap="onHistory" aria-role="button">
        <text class="row-label">记录</text>
        <view class="row-trail">
          <text class="row-value">CLI 和手机的查询</text>
          <t-icon name="chevron-right" tone="muted" size="32" />
        </view>
      </view>
      <view class="row" bindtap="onStats" aria-role="button">
        <text class="row-label">学习统计</text>
        <view class="row-trail">
          <text class="row-value">日历、连续天数、保持率</text>
          <t-icon name="chevron-right" tone="muted" size="32" />
        </view>
      </view>
      <view class="row" bindtap="onWeekly" aria-role="button">
        <text class="row-label">周报</text>
        <t-icon name="chevron-right" tone="muted" size="32" />
      </view>
      <view class="row" bindtap="onLibrary" aria-role="button">
        <text class="row-label">词库</text>
        <t-icon name="chevron-right" tone="muted" size="32" />
      </view>

      <text class="section-title">翻译</text>
      <view
        class="row"
        data-key="showDirection"
        bindtap="onToggle"
        aria-role="switch"
        aria-checked="{{showDirection}}"
        aria-label="显示翻译方向按钮"
      >
        <view class="row-text">
          <text class="row-label">显示翻译方向按钮</text>
          <text class="row-hint">{{directionHint}}</text>
        </view>
        <view class="switch {{showDirection ? 'switch-on' : ''}}"><view class="knob {{showDirection ? 'knob-on' : ''}}"></view></view>
      </view>
      <view
        class="row"
        data-key="autoSpeakWord"
        bindtap="onToggle"
        aria-role="switch"
        aria-checked="{{autoSpeakWord}}"
        aria-label="查单词后自动朗读"
      >
        <text class="row-label">查单词后自动朗读</text>
        <view class="switch {{autoSpeakWord ? 'switch-on' : ''}}"><view class="knob {{autoSpeakWord ? 'knob-on' : ''}}"></view></view>
      </view>
      <picker mode="selector" range="{{langOptions}}" value="{{langIndex}}" bindchange="onLang">
        <view class="row" aria-role="button" aria-label="释义语言：{{langLabel}}">
          <text class="row-label">释义语言</text>
          <view class="row-trail">
            <text class="row-value">{{langLabel}}</text>
            <t-icon name="chevron-right" tone="muted" size="32" />
          </view>
        </view>
      </picker>

      <text class="section-title">笔记本与复习</text>
      <view
        class="row"
        data-key="importanceReview"
        bindtap="onToggle"
        aria-role="switch"
        aria-checked="{{importanceReview}}"
        aria-label="按重要程度安排复习"
      >
        <view class="row-text">
          <text class="row-label">按重要程度安排复习</text>
          <text class="row-hint">星越多，复习越勤；4 星优先进每日材料</text>
        </view>
        <view class="switch {{importanceReview ? 'switch-on' : ''}}"><view class="knob {{importanceReview ? 'knob-on' : ''}}"></view></view>
      </view>
      <view
        class="row"
        data-key="autoSpeakOnFlip"
        bindtap="onToggle"
        aria-role="switch"
        aria-checked="{{autoSpeakOnFlip}}"
        aria-label="复习翻面后自动朗读"
      >
        <text class="row-label">复习翻面后自动朗读</text>
        <view class="switch {{autoSpeakOnFlip ? 'switch-on' : ''}}"><view class="knob {{autoSpeakOnFlip ? 'knob-on' : ''}}"></view></view>
      </view>

      <block wx:if="{{reminderAvailable}}">
        <picker mode="selector" range="{{reminderOptions}}" value="{{reminderIndex}}" bindchange="onReminderHour">
          <view class="row" aria-role="button" aria-label="复习提醒：{{reminderLabel}}">
            <text class="row-label">复习提醒</text>
            <view class="row-trail">
              <text class="row-value">{{reminderLabel}}</text>
              <t-icon name="chevron-right" tone="muted" size="32" />
            </view>
          </view>
        </picker>
        <block wx:if="{{reminderOn}}">
          <view class="row" bindtap="onGrant" aria-role="button" aria-label="接收下一次提醒，{{grantText}}">
            <text class="row-label">接收下一次提醒</text>
            <text class="row-value {{grantText === '点此允许' ? 'row-accent' : ''}}">{{granting ? '…' : grantText}}</text>
          </view>
          <text class="setting-note">有到期的卡片时才提醒。微信每次允许只能发一条提醒，收到后回来再点一次「接收下一次提醒」；在弹窗里勾选「总是保持以上选择」，以后点一下即可。</text>
        </block>
      </block>

      <text class="section-title">外观</text>
      <view class="row">
        <text class="row-label">主题色</text>
        <view class="swatches" aria-role="radiogroup" aria-label="主题色">
          <view
            wx:for="{{accents}}"
            wx:key="id"
            class="swatch"
            data-accent="{{item.id}}"
            bindtap="onAccent"
            aria-role="radio"
            aria-checked="{{item.checked}}"
            aria-label="{{item.label}}"
          >
            <view class="swatch-ring" style="{{item.ringStyle}}">
              <view class="swatch-dot" style="background-color: {{item.color}};"></view>
            </view>
          </view>
        </view>
      </view>
      <view class="row" bindtap="onAppearance" aria-role="button" aria-label="深浅模式：{{themeModeText}}">
        <text class="row-label">深浅模式</text>
        <view class="row-trail">
          <text class="row-value">{{themeModeText}}</text>
          <t-icon name="chevron-right" tone="muted" size="32" />
        </view>
      </view>
      <view class="row" bindtap="onAppearance" aria-role="button" aria-label="阅读模式：{{readingText}}">
        <text class="row-label">阅读模式</text>
        <view class="row-trail">
          <text class="row-value">{{readingText}}</text>
          <t-icon name="chevron-right" tone="muted" size="32" />
        </view>
      </view>
      <view class="saved-note">
        <t-icon name="cloud-check" tone="muted" size="28" />
        <text class="saved-note-text">设置会自动保存到账号，换手机或重新安装也不会丢</text>
      </view>

      <text class="section-title">账号</text>
      <view class="row" bindtap="onDevices" aria-role="button">
        <text class="row-label">设备</text>
        <view class="row-trail">
          <text class="row-value">查看和撤销</text>
          <t-icon name="chevron-right" tone="muted" size="32" />
        </view>
      </view>
      <view class="row" bindtap="onAccount" aria-role="button">
        <text class="row-label">账号与数据</text>
        <view class="row-trail">
          <text class="row-value">导出、注销</text>
          <t-icon name="chevron-right" tone="muted" size="32" />
        </view>
      </view>

      <text class="section-title">授权 CLI 登录</text>
      <view class="row" bindtap="onScan" aria-role="button">
        <text class="row-label">扫描终端里的二维码</text>
        <t-icon name="chevron-right" tone="muted" size="32" />
      </view>
      <view class="row" bindtap="onTypeCode" aria-role="button">
        <text class="row-label">输入 6 位授权码</text>
        <t-icon name="chevron-right" tone="muted" size="32" />
      </view>

      <text wx:if="{{serverLabel}}" class="section-title">开发版 · {{serverLabel}}</text>
    </view>
  </scroll-view>
</view>
