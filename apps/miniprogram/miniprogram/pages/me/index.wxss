/* Layout only: rows, switches, section heads and type come from app.wxss (README "Design system"). */

/* A settings group's heading: 32rpx plus .section-head's own room keeps groups ~48rpx apart. */
.group-head {
  margin-top: 32rpx;
}

.row-accent {
  color: var(--accent);
}

.setting-note {
  display: block;
  padding: 16rpx 0 8rpx;
}

/* 主题色: five round swatches, the chosen one ringed in its own colour. */
.swatches {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

/* A 36 px target around a 24 px dot; px so the target keeps its size on every screen. */
.swatch {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
}

.swatch-ring {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 16px;
  border: 2px solid transparent;
}

.swatch-dot {
  width: 24px;
  height: 24px;
  border-radius: 12px;
}

/* The footnote under the settings: a cloud with a check, then the text. */
.saved-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 40rpx;
}

.server-label {
  display: block;
  margin-top: 48rpx;
}
