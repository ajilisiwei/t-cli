/*
 * 学习计划. Type (.t-*) and the shared pieces (card-surface, seg-control,
 * choice-chip, switch, rows, section-head) live in app.wxss.
 */
.lp-head {
  margin-top: 24rpx;
}

.lp-card {
  display: flex;
  flex-direction: column;
}

.lp-hint {
  display: block;
  margin-top: 16rpx;
}

.lp-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--rule);
}

.lp-sub {
  display: block;
  margin-bottom: 16rpx;
}

/* Seven equal weekday buttons; the level row reuses them. */
.lp-days,
.lp-levels {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.lp-days {
  margin-top: 24rpx;
}

/* A control: the chip size (26). */
.lp-day {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border: 1px solid var(--rule);
  border-radius: 24rpx;
  background-color: var(--surface);
  color: var(--ink-soft);
  font-size: 26rpx;
  font-weight: 600;
}

.lp-day-on {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--accent-ink);
}

.lp-switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.lp-muted {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 80rpx;
  margin-top: 12rpx;
}

.lp-muted-text {
  flex: 1;
}

/* 恢复推荐: a link with a 64rpx target. */
.lp-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  padding: 0;
}

/* The rows sit inside a card: no padding on the card, the rows carry it. */
.lp-rows {
  padding: 0 32rpx;
}

.lp-row {
  min-height: 104rpx;
}

.lp-saved {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-top: 32rpx;
}
