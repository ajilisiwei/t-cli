<view class="page theme-{{theme}} {{accentClass}}">
  <nav-bar title="查询记录" back />

  <!-- Search, calendar, day strip and source filter stay above the list -->
  <view class="filters">
    <view class="search-line">
      <view class="search {{searchFocused ? 'search-focused' : ''}}">
        <t-icon name="search" tone="muted" size="30" />
        <input
          class="search-input"
          type="text"
          confirm-type="search"
          maxlength="100"
          placeholder="搜索记录"
          placeholder-class="placeholder"
          aria-label="搜索记录"
          value="{{query}}"
          bindinput="onQueryInput"
          bindconfirm="onQueryConfirm"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
        />
        <view wx:if="{{query}}" class="icon-btn icon-btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onClearQuery" aria-role="button" aria-label="清空搜索">
          <t-icon name="close" tone="muted" size="28" />
        </view>
      </view>
      <picker mode="date" value="{{pickerValue}}" end="{{today}}" bindchange="onPickDate">
        <view class="calendar-btn" hover-class="pressed" hover-stay-time="80" aria-role="button" aria-label="选择日期">
          <t-icon name="calendar" tone="accent" size="34" />
        </view>
      </picker>
    </view>

    <scroll-view
      class="strip"
      scroll-x
      enable-flex
      show-scrollbar="{{false}}"
      scroll-into-view="{{stripInto}}"
      scroll-with-animation
    >
      <view class="strip-row">
        <view
          class="day {{selectedDate === '' ? 'day-on' : ''}}"
          hover-class="pressed"
          hover-stay-time="80"
          bindtap="onAllDays"
          aria-role="button"
          aria-label="全部日期{{selectedDate === '' ? '，已选' : ''}}"
        >
          <text class="day-top">全部</text>
          <view class="day-dot" />
          <view class="day-count" />
        </view>
        <view
          wx:for="{{chips}}"
          wx:key="date"
          id="{{item.anchor}}"
          class="day {{item.selected ? 'day-on' : ''}} {{item.empty ? 'day-empty' : ''}}"
          hover-class="{{item.empty ? 'none' : 'pressed'}}"
          hover-stay-time="80"
          data-date="{{item.date}}"
          data-empty="{{item.empty}}"
          bindtap="onDayChip"
          aria-role="button"
          aria-disabled="{{item.empty}}"
          aria-label="{{item.aria}}"
        >
          <text class="day-top">{{item.top}}</text>
          <text class="day-mid">{{item.mid}}</text>
          <text class="day-count">{{item.countLabel}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="choice-chips sources">
      <view
        wx:for="{{sourceChips}}"
        wx:key="value"
        class="choice-chip {{item.value === sourceValue ? 'choice-chip-on' : ''}}"
        hover-class="pressed"
        hover-stay-time="80"
        data-value="{{item.value}}"
        bindtap="onSourceChip"
        aria-role="button"
        aria-label="来源 {{item.label}}{{item.value === sourceValue ? '，已选' : ''}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <scroll-view
    class="body"
    scroll-y
    type="list"
    show-scrollbar="{{false}}"
    lower-threshold="240"
    bindscrolltolower="onLoadMore"
    refresher-enabled
    refresher-default-style="{{theme === 'dark' ? 'white' : 'black'}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="list">
      <text wx:if="{{offline}}" class="t-caption notice-line">需要联网 · 显示的是上次缓存的记录</text>

      <view wx:for="{{groups}}" wx:key="date" wx:for-item="group" class="group">
        <view class="group-head">
          <text class="t-label group-label">{{group.label}}</text>
          <text class="t-caption">{{group.full}}</text>
          <view class="group-rule" />
          <text class="t-caption">{{group.countLabel}}</text>
        </view>

        <view
          wx:for="{{group.rows}}"
          wx:key="id"
          class="entry"
          hover-class="pressed"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="onToggle"
          aria-role="button"
          aria-expanded="{{expandedId === item.id}}"
          aria-label="{{item.time}} {{item.sourceLabel}} {{item.taskLabel}}：{{item.input}}"
        >
          <text class="t-caption entry-time">{{item.time}}</text>
          <view class="entry-main">
            <block wx:if="{{expandedId === item.id}}">
              <text class="t-body entry-input {{item.serif ? 'serif' : ''}}" user-select>{{item.input}}</text>
              <text class="t-secondary entry-output" user-select>{{item.output}}</text>
            </block>
            <block wx:else>
              <text class="t-body entry-input clamp-1 {{item.serif ? 'serif' : ''}}" max-lines="1" overflow="ellipsis">{{item.input}}</text>
              <text class="t-secondary entry-preview clamp-1" max-lines="1" overflow="ellipsis">{{item.preview}}</text>
            </block>
            <view class="tags">
              <text class="label-tag {{item.source === 'cli' ? 'tag-cli' : 'label-tag-soft'}}">{{item.sourceLabel}}</text>
              <text class="label-tag">{{item.taskLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- First load: rows shaped like records. Loading more: one row at the end. -->
      <view wx:if="{{loading && !refreshing}}" aria-label="加载中">
        <view wx:if="{{groups.length === 0}}" class="group-head">
          <view class="skel skel-pulse hs-skel-label" />
          <view class="group-rule" />
        </view>
        <view wx:for="{{groups.length === 0 ? [1, 2, 3, 4, 5] : [1]}}" wx:key="*this" class="entry">
          <view class="skel skel-pulse hs-skel-time" />
          <view class="entry-main">
            <view class="skel skel-line skel-pulse hs-skel-input" />
            <view class="skel skel-line skel-pulse hs-skel-preview" />
          </view>
        </view>
      </view>

      <view wx:if="{{errorText && !offline}}" class="state hs-state">
        <text class="state-text state-error">{{errorText}}</text>
        <view class="btn btn-secondary btn-sm" hover-class="pressed" hover-stay-time="80" bindtap="onRetry" aria-role="button"><text>重试</text></view>
      </view>
      <view wx:elif="{{loaded && groups.length === 0 && !loading}}" class="state hs-state">
        <text class="state-text">{{emptyText}}</text>
      </view>
      <text wx:elif="{{loaded && groups.length > 0 && !hasMore && !loading}}" class="t-caption list-end">没有更早的记录了</text>
    </view>
  </scroll-view>
</view>
