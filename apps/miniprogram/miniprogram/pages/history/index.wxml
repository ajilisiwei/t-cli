<view class="page theme-{{theme}}">
  <nav-bar title="记录" back />
  <scroll-view
    class="body"
    scroll-y
    type="list"
    show-scrollbar="{{false}}"
    lower-threshold="240"
    bindscrolltolower="onLoadMore"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="content">
      <text wx:if="{{offline}}" class="direction">需要联网 · 显示的是上次缓存的记录</text>

      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="entry"
        data-id="{{item.id}}"
        bindtap="onToggle"
        aria-role="button"
      >
        <text class="entry-meta">{{item.sourceLabel}} · {{item.taskLabel}} · {{item.time}}</text>
        <text class="entry-input {{expandedId === item.id ? '' : 'clamp'}}">{{item.input}}</text>
        <text wx:if="{{expandedId === item.id}}" class="entry-output" user-select>{{item.output}}</text>
        <text wx:else class="entry-output clamp">{{item.preview}}</text>
      </view>

      <text wx:if="{{loaded && rows.length === 0 && !errorText}}" class="empty">还没有记录</text>
      <text wx:if="{{errorText && !offline}}" class="error">{{errorText}}</text>
      <text wx:if="{{loading && !refreshing}}" class="empty">加载中…</text>
      <text wx:elif="{{loaded && rows.length > 0 && !hasMore}}" class="empty">没有更早的记录了</text>
    </view>
  </scroll-view>
</view>
