/* Layout only; buttons and icons come from app.wxss (README "Design system").
 * Rounded boxes use one border colour. */

/* ---- filters (fixed above the list) ---- */
.filters {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 8rpx 0 20rpx;
  border-bottom: 1px solid var(--rule);
}

.search-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx;
}

.search {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 8rpx 0 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 36rpx;
}

.search-focused {
  border-color: var(--accent);
}

.search-input {
  flex: 1;
  height: 72rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.calendar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
}

/* ---- day strip ---- */
.strip {
  width: 100%;
  white-space: nowrap;
}

.strip-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 40rpx;
}

.day {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 124rpx;
  border-radius: 24rpx;
  border: 1px solid var(--rule);
  background-color: var(--surface);
  color: var(--ink);
}

.day-on {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--accent-ink);
}

.day-empty {
  opacity: 0.45;
}

.day-top {
  font-size: 22rpx;
  line-height: 1.3;
}

.day-mid {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.day-count {
  height: 26rpx;
  font-size: 20rpx;
  line-height: 26rpx;
}

/* The 全部 chip's middle line: a dot drawn, not typed. */
.day-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 0;
  border-radius: 5rpx;
  background-color: var(--muted);
}

/* ---- source filter ---- */
.sources {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 40rpx;
}

.source {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  border: 1px solid var(--rule);
  color: var(--ink-soft);
  font-size: 26rpx;
}

.source-on {
  border-color: var(--accent-soft);
  background-color: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

/* ---- grouped list ---- */
.list {
  padding: 0 0 96rpx;
}

.notice-line {
  display: block;
  padding: 20rpx 40rpx 0;
  color: var(--muted);
  font-size: 26rpx;
}

.group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 40rpx 12rpx;
}

.group-label {
  font-size: 26rpx;
  font-weight: 600;
}

.group-full {
  color: var(--muted);
  font-size: 24rpx;
}

.group-rule {
  flex: 1;
  height: 1px;
  background-color: var(--rule);
}

.group-count {
  color: var(--muted);
  font-size: 24rpx;
}

.entry {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 18rpx 40rpx;
}

.entry-time {
  flex-shrink: 0;
  width: 80rpx;
  padding-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.entry-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entry-input {
  display: block;
  font-size: 30rpx;
  line-height: 1.45;
  word-break: break-word;
}

.entry-preview {
  display: block;
  color: var(--muted);
  font-size: 26rpx;
}

.entry-output {
  display: block;
  margin-top: 4rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.clamp-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding-top: 4rpx;
}

.tag {
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background-color: var(--rule);
  color: var(--ink-soft);
  font-size: 20rpx;
  white-space: nowrap;
}

.tag-cli {
  background-color: var(--ink);
  color: var(--bg);
}

.tag-mp {
  background-color: var(--accent-soft);
  color: var(--accent);
}

/* The list has no side padding (rows run edge to edge); its messages do. */
.list-message {
  margin-left: 40rpx;
  margin-right: 40rpx;
}
