/* Layout only: type comes from the scale (.t-*), chips, tags, buttons,
 * icons and states from app.wxss (README "Design system"). Rounded boxes
 * use one border colour. */

/* ---- filters (fixed above the list) ---- */
.filters {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
  border-bottom: 1px solid var(--rule);
}

.search-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx;
}

.search {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 8rpx 0 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 36rpx;
}

.search-focused {
  border-color: var(--accent);
}

.search-input {
  flex: 1;
  height: 72rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.calendar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
}

/* ---- day strip ---- */
.strip {
  width: 100%;
  white-space: nowrap;
}

.strip-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 40rpx;
}

.day {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 124rpx;
  border-radius: 24rpx;
  border: 1px solid var(--rule);
  background-color: var(--surface);
  color: var(--ink);
}

.day-on {
  border-color: var(--accent);
  background-color: var(--accent);
  color: var(--accent-ink);
}

/* Known to be empty: looks as disabled as .btn-disabled. */
.day-empty {
  opacity: 0.4;
}

/* The chip's three lines follow its colour (accent-ink when chosen), so they
 * carry scale sizes but no .t-* colour. */
.day-top {
  font-size: 24rpx;
  line-height: 1.4;
}

.day-mid {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.day-count {
  height: 32rpx;
  font-size: 24rpx;
  line-height: 32rpx;
}

/* The 全部 chip's middle line: a dot drawn, not typed. */
.day-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 16rpx 0;
  border-radius: 5rpx;
  background-color: var(--muted);
}

/* ---- source filter ---- */
.sources {
  padding: 0 40rpx;
}

/* ---- grouped list (rows run edge to edge; their content keeps the 40rpx sides) ---- */
.list {
  padding: 0 0 96rpx;
}

.notice-line {
  display: block;
  padding: 24rpx 40rpx 0;
}

.group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 40rpx 12rpx;
}

.group-label {
  color: var(--ink);
}

.group-rule {
  flex: 1;
  height: 1px;
  background-color: var(--rule);
}

.entry {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 40rpx;
}

/* Centred on the first line of the record (32rpx × 1.6). */
.entry-time {
  flex-shrink: 0;
  width: 80rpx;
  padding-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.entry-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.entry-input {
  display: block;
  word-break: break-word;
}

.entry-preview {
  display: block;
  color: var(--muted);
}

.entry-output {
  display: block;
  margin-top: 8rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.clamp-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding-top: 8rpx;
}

/* CLI records: an ink tag (app.wxss .label-tag has no ink variant). */
.tag-cli {
  background-color: var(--ink);
  color: var(--bg);
}

.hs-state {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.list-end {
  display: block;
  padding: 48rpx 40rpx;
  text-align: center;
}

/* ---- skeleton rows (app.wxss .skel), breathing while a page loads ---- */
.skel-pulse {
  animation-name: hs-pulse;
  animation-duration: 900ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes hs-pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.45;
  }
}

.hs-skel-label {
  width: 96rpx;
  height: 26rpx;
}

.hs-skel-time {
  flex-shrink: 0;
  width: 80rpx;
  height: 24rpx;
  margin-top: 12rpx;
}

.hs-skel-input {
  width: 64%;
  height: 32rpx;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

.hs-skel-preview {
  width: 40%;
  height: 24rpx;
  margin-bottom: 8rpx;
}
