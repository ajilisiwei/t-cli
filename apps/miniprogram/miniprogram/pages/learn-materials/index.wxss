/*
 * 学习资料 list. Type (.t-*) and the shared pieces (seg-control, label-tag,
 * tick, bottom-bar, state, skel) live in app.wxss. The root is positioned so
 * the export sheet can sit over the page.
 */
.lm-page {
  position: relative;
  overflow: hidden;
}

.lm-head {
  flex-shrink: 0;
  padding: 8rpx 40rpx 0;
  background-color: var(--bg);
}

.lm-tools {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
}

/* 选择 / 完成: a link with a 64rpx target. */
.lm-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  padding: 0 0 0 24rpx;
}

.lm-content {
  padding-top: 0;
}

.lm-week {
  display: block;
  padding: 24rpx 0 8rpx;
}

.lm-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.lm-row-off {
  opacity: 0.4;
}

.lm-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lm-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

/* A title, or an extension's first reason: one line. */
.lm-one-line {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lm-status {
  margin-top: 8rpx;
}

.lm-more {
  display: block;
  padding: 32rpx 0;
  text-align: center;
}

.lm-picked {
  flex: 1;
}

/* ---- loading ---- */
.lm-skel-week {
  width: 96rpx;
  margin-top: 24rpx;
}

.lm-skel-row {
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.lm-skel-tag {
  width: 240rpx;
}

.lm-skel-title {
  width: 75%;
  height: 40rpx;
  margin-bottom: 16rpx;
}

.lm-skel-meta {
  width: 50%;
  margin-bottom: 0;
}
