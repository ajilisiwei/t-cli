/*
 * Layout of 翻译. The pieces (composer, buttons, icon buttons, stars, type
 * scale, states) come from app.wxss; this file places them and draws what
 * only this page has: tappable words, numbered changes, the docked bar and
 * the sheet. Sizes stay on the type scale (README "Design system → Type").
 * Skyline: one border colour per rounded box, motion on transform/opacity,
 * no baseline alignment across fonts or sizes.
 */
.tr-page {
  position: relative;
  overflow: hidden;
}

/* ---- composer ---- */
.tr-field {
  position: relative;
}

/* Eight lines (34rpx × 1.55): past that the box stops growing and scrolls. */
.tr-input-tall {
  height: 422rpx;
}

/* The empty-box hint lies over the textarea; taps go through to it, except on 粘贴. */
.tr-hint {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
}

/* Same size as the textarea it stands in for (.composer-input). */
.tr-hint-text {
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1.55;
}

.tr-paste {
  pointer-events: auto;
}

.tr-preview {
  padding: 8rpx 0;
}

.tr-preview-text {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: var(--ink-soft);
  word-break: break-word;
}

.tr-bar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.tr-dir {
  padding: 0 24rpx;
}

/* 纠错 while its result shows. */
.tr-current {
  border-color: var(--accent);
}

/* ---- result ---- */
.tr-meta {
  display: block;
  margin-bottom: 16rpx;
}

.tr-label {
  display: block;
  margin-bottom: 8rpx;
}

.tr-label-after {
  margin-top: 12rpx;
}

/* The translation: Chinese at 34, English (serif) at 40 like the tappable words. */
.tr-output {
  display: block;
  font-size: 34rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.tr-output-en {
  font-size: 40rpx;
}

.tr-headline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.tr-head {
  word-break: break-all;
}

.tr-head-long {
  font-size: 40rpx;
}

.tr-head-xlong {
  font-size: 34rpx;
}

.tr-gloss {
  display: block;
  margin-top: 12rpx;
}

.tr-explanation {
  display: block;
  margin-top: 32rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

/* A text link with a chevron; at least 64rpx tall to tap. */
.tr-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  margin-top: 16rpx;
}

.tr-chevron {
  display: flex;
  transform: rotate(90deg);
}

.tr-chevron-up {
  transform: rotate(-90deg);
}

.tr-wait {
  padding-top: 16rpx;
}

.tr-note {
  display: block;
  margin-top: 16rpx;
}

/* ---- skeletons (app.wxss .skel), breathing while they wait ---- */
.skel-pulse {
  animation-name: tr-pulse;
  animation-duration: 900ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes tr-pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.45;
  }
}

.tr-w88 {
  width: 88%;
}

.tr-w80 {
  width: 80%;
}

.tr-w72 {
  width: 72%;
}

.tr-w64 {
  width: 64%;
}

/* ---- tappable words (lib/tokens.ts): chips wrap, words inside them tap ----
 * Baseline alignment is safe here: every word has the same font and size. */
.tokens {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.7;
}

.tokens-big {
  font-size: 40rpx;
  line-height: 1.6;
}

/* A word space, not layout spacing. */
.chip {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-right: 10rpx;
}

.tok-word {
  text-decoration-line: underline;
  text-decoration-color: var(--rule);
}

.tok-on {
  color: var(--accent);
  background-color: var(--accent-soft);
  text-decoration-color: var(--accent);
}

.tok-break {
  width: 100%;
  height: 0;
}

.tok-para {
  height: 24rpx;
}

.tr-source {
  margin-top: 32rpx;
}

/* Six lines of .tokens (34rpx × 1.7). */
.tr-source-clamped {
  max-height: 347rpx;
  overflow: hidden;
}

.tr-fold {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border: 1px solid var(--rule);
  border-radius: 24rpx;
  background-color: var(--surface);
}

.tr-fold-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: var(--accent);
}

/* ---- 纠错: numbered changes ---- */
.tr-mark {
  padding: 0 6rpx;
  color: var(--accent);
  background-color: var(--accent-soft);
  font-family: -apple-system, 'PingFang SC', sans-serif;
  font-size: 24rpx;
}

.tr-rows {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.tr-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

/* Centred on the first line of .tr-change (28rpx × 1.55). */
.tr-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.tr-badge-space {
  flex-shrink: 0;
  width: 40rpx;
}

.tr-row-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.tr-change {
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}

.tr-before {
  color: var(--danger);
  text-decoration: line-through;
}

.tr-after {
  color: var(--accent);
}

.tr-why {
  word-break: break-word;
}

/* ---- actions: inline under the result, or docked ---- */
/* One line: the stars stay beside the bookmark. With wrap, Skyline sized the
 * icon group to its content and pushed the stars to a second line. The row
 * fits on 360 px screens, docked with 朗读 progress and 回到顶部 included
 * (hence a 16rpx gap, not 24). */
.tr-actions {
  flex-wrap: nowrap;
  justify-content: space-between;
}

.tr-icons {
  display: flex;
  flex-direction: row;
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
  align-items: center;
  gap: 16rpx;
}

.tr-progress {
  color: var(--accent);
}

.tr-top {
  border: 1px solid var(--rule);
  background-color: var(--surface);
}

/* 120rpx: DOCK_BAR_PX in view.ts. A tab page: the tab bar below keeps the home indicator. */
.tr-dock {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  padding: 0 40rpx;
  border-top: 1px solid var(--rule);
  background-color: var(--surface);
}

/* ---- 点词查词 sheet ---- */
.tr-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 16rpx 40rpx 0;
  border: 1px solid var(--rule);
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  background-color: var(--surface);
  box-shadow: 0 -16rpx 56rpx rgba(29, 28, 26, 0.12);
  animation-name: tr-rise;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
}

@keyframes tr-rise {
  from {
    opacity: 0;
    transform: translateY(48rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tr-grip {
  flex-shrink: 0;
  align-self: center;
  width: 72rpx;
  height: 10rpx;
  margin-bottom: 12rpx;
  border-radius: 5rpx;
  background-color: var(--rule);
}

.tr-sheet-head {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.tr-sheet-title {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

/* Head word and IPA differ in font and size: centred, not on a baseline. */
.tr-sheet-word {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.tr-sheet-lemma {
  word-break: break-all;
}

.tr-sheet-actions {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tr-sheet-body {
  flex: 1;
  height: 0;
  margin-top: 16rpx;
  border-top: 1px solid var(--rule);
}

.tr-sheet-inner {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 0 48rpx;
}

/* The size of a one-line 在本句中 box. */
.tr-skel-context {
  height: 112rpx;
  border-radius: 24rpx;
}

.tr-sheet-state {
  padding: 48rpx 0;
}

.tr-context {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
}

.tr-context-label {
  color: var(--accent);
}

/* The phrase row (option B): bookmark on the right, its stars on a line below the text. */
.tr-phrase {
  display: flex;
  flex-direction: column;
  padding: 12rpx 12rpx 12rpx 24rpx;
  border: 1px solid var(--rule);
  border-radius: 24rpx;
}

.tr-phrase-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tr-phrase-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.tr-phrase-en {
  word-break: break-word;
}

/* The first star's target starts at the text's edge. */
.tr-phrase-stars {
  display: flex;
  flex-direction: row;
  margin-left: -14rpx;
}

.tr-senses {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* Part of speech (serif) and gloss share size and line height: top-aligned. */
.tr-sense {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.tr-pos {
  flex-shrink: 0;
  width: 72rpx;
  color: var(--muted);
  font-style: italic;
}

.tr-sense-gloss {
  flex: 1;
  min-width: 0;
}
