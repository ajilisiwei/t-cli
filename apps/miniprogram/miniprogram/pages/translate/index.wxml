<view class="page theme-{{theme}}">
  <nav-bar title="翻译" />
  <scroll-view class="body" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="content">
      <view class="composer {{focused ? 'composer-focused' : ''}}">
        <textarea
          class="composer-input"
          value="{{input}}"
          focus="{{focus}}"
          auto-height
          maxlength="2000"
          confirm-type="send"
          show-confirm-bar="{{false}}"
          adjust-position
          placeholder="输入中文或外语"
          placeholder-class="placeholder"
          bindinput="onInput"
          bindconfirm="onSubmit"
          bindfocus="onFocus"
          bindblur="onBlur"
        />
        <view class="composer-bar">
          <text wx:if="{{!input}}" class="composer-hint">中文译英文 · 外语译中文</text>
          <view class="composer-actions">
            <view wx:if="{{input}}" class="icon-btn" bindtap="onClear" aria-role="button" aria-label="清空">
              <t-icon name="close" tone="muted" size="32" />
            </view>
            <view
              wx:if="{{voiceEnabled}}"
              class="icon-btn {{recording ? 'icon-btn-tonal' : ''}}"
              bindtouchstart="onMicStart"
              bindtouchend="onMicEnd"
              bindtouchcancel="onMicEnd"
              aria-role="button"
              aria-label="按住说话"
            >
              <t-icon name="mic" tone="{{recording ? 'accent' : 'muted'}}" size="36" />
            </view>
            <view class="btn btn-primary btn-sm {{input ? '' : 'btn-disabled'}}" bindtap="onSend" aria-role="button" aria-label="翻译">
              <text>翻译</text>
            </view>
          </view>
        </view>
        <text wx:if="{{recording}}" class="hint">正在听，松开即翻译</text>
      </view>

      <view wx:if="{{status !== 'idle'}}" class="result">
        <view wx:if="{{label}}" class="direction" bindtap="onFlip" aria-role="button" aria-label="反向翻译">
          <text>{{label}}</text>
          <text wx:if="{{!busy}}" class="direction-flip">　反向</text>
        </view>

        <block wx:if="{{headline}}">
          <view class="headline">
            <text class="head serif" user-select>{{headline.head}}</text>
            <text class="ipa">/{{headline.ipa}}/</text>
          </view>
          <text wx:if="{{headline.gloss}}" class="gloss" user-select>{{headline.gloss}}</text>
          <text wx:if="{{headline.rest}}" class="explanation" user-select>{{headline.rest}}</text>
        </block>
        <text wx:elif="{{text}}" class="output {{english ? 'serif output-en' : ''}}" user-select>{{text}}</text>

        <text wx:if="{{status === 'waiting'}}" class="muted">翻译中…</text>
        <text wx:if="{{status === 'stopped'}}" class="muted">已停止</text>
        <text wx:if="{{errorText}}" class="error">{{errorText}}</text>

        <view class="actions">
          <view wx:if="{{busy}}" class="btn btn-tonal btn-sm btn-icon-first" bindtap="onStop" aria-role="button">
            <t-icon name="stop" tone="accent" size="32" />
            <text>停止</text>
          </view>
          <block wx:else>
            <view class="btn btn-tonal btn-sm btn-icon-first {{canSpeak ? '' : 'btn-disabled'}}" bindtap="onSpeak" aria-role="button">
              <t-icon name="speaker" tone="accent" size="32" />
              <text>朗读</text>
            </view>
            <view class="btn btn-tonal btn-sm btn-icon-first {{text ? '' : 'btn-disabled'}}" bindtap="onCopy" aria-role="button">
              <t-icon name="copy" tone="accent" size="32" />
              <text>复制</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
