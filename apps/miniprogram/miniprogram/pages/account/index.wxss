/* The export file, ready to send: a quiet surface like the composer. */
.file {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 32rpx;
  padding: 20rpx 20rpx 20rpx 28rpx;
  background-color: var(--surface);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.file-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.file-name {
  display: block;
  font-size: 28rpx;
  word-break: break-all;
}

.file-size {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
}


.facts {
  margin-top: 8rpx;
}

.fact {
  display: block;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}
