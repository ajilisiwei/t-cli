/* Layout only; rows, type, cards and buttons come from app.wxss (README "Design system"). */

/* A settings group's heading: 32rpx plus .section-head's own room keeps groups ~48rpx apart. */
.group-head {
  margin-top: 32rpx;
}

/* 注册时间 while it loads: a skeleton the width of a date. */
.since-skel {
  width: 200rpx;
  height: 28rpx;
}

.para {
  display: block;
  margin-top: 16rpx;
}

/* The export file, ready to send: a card with its 发送 action at the end. */
.file {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
}

.file-info {
  flex: 1;
  min-width: 0;
}

.file-name {
  display: block;
  color: var(--ink);
  word-break: break-all;
}

.file-size {
  display: block;
}

.facts {
  margin-top: 8rpx;
}

.fact {
  display: block;
}
