/*
 * 拓展资料. Type (.t-*) and the shared pieces (card-surface, label-tag,
 * tick, bottom-bar, marks, section-head, state, skel) live in app.wxss;
 * this file lays them out. The root is positioned so the export sheet can
 * sit over the page.
 */
.xt-page {
  position: relative;
  overflow: hidden;
}

.xt-head {
  padding-top: 8rpx;
}

.xt-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.xt-title {
  display: block;
  margin-top: 16rpx;
}

.xt-block {
  display: block;
}

/* A text link with a 64rpx target (全选, 不感兴趣). */
.xt-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  padding: 0;
}

/* ---- 为什么推荐给你 ---- */
.xt-why {
  margin-top: 32rpx;
}

.xt-why-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.xt-reason {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 8rpx;
}

/* A bullet drawn as a dot (no text glyphs), centred on the first line (28rpx × 1.55). */
.xt-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background-color: var(--muted);
}

.xt-reason-text {
  flex: 1;
}

/* ---- items ---- */
.xt-section {
  margin-top: 40rpx;
}

.xt-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

/* 已在复习 in place of the tick: two lines of two characters. */
.xt-known {
  flex-shrink: 0;
  width: 56rpx;
  text-align: center;
}

.xt-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.xt-item-line {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

/* An item in the list: serif at the reading size, tighter than a paragraph. */
.xt-item-text {
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.4;
}

.xt-item-known {
  color: var(--muted);
}

/* ---- passage and grammar ---- */
.xt-passage {
  margin-top: 40rpx;
}

/* 看中文 and 朗读, side by side at the end of the head. */
.xt-passage-tools {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.xt-passage-text {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.xt-passage-zh {
  display: block;
  margin-top: 16rpx;
}

.xt-grammar {
  margin-top: 40rpx;
}

.xt-pair {
  margin-top: 16rpx;
}

.xt-wrong {
  flex: 1;
  color: var(--muted);
  text-decoration: line-through;
}

.xt-right {
  flex: 1;
  color: var(--ink);
}

.xt-notice {
  display: block;
  margin-top: 40rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
}

/* ---- loading ---- */
.xt-skel-tag {
  width: 320rpx;
}

.xt-skel-title {
  width: 80%;
  height: 54rpx;
}

.xt-skel-why {
  margin-top: 32rpx;
  border-radius: 32rpx;
}

.xt-skel-label {
  width: 240rpx;
  margin-top: 40rpx;
}

.xt-skel-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding: 24rpx 0;
}

.xt-skel-tick {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
}

.xt-skel-text {
  flex: 1;
}

.xt-skel-word {
  width: 50%;
}

/* ---- bottom bar ---- */
.xt-dismiss {
  padding: 0 8rpx;
  color: var(--ink-soft);
}

.xt-pdf {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 1px solid var(--rule);
}

.xt-grow {
  flex: 1;
}
