/*
 * 拓展资料. Shared pieces (card-surface, label-tag, tick, bottom-bar, marks)
 * live in app.wxss. The root is positioned so the export sheet can sit over
 * the page.
 */
.xt-page {
  position: relative;
  overflow: hidden;
}

.xt-head {
  padding-top: 8rpx;
}

.xt-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.xt-meta {
  color: var(--muted);
  font-size: 24rpx;
}

.xt-title {
  display: block;
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.35;
}

/* ---- 为什么推荐给你 ---- */
.xt-why {
  margin-top: 36rpx;
}

.xt-why-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.xt-why-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.xt-reason {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 8rpx;
}

/* A bullet drawn as a dot (no text glyphs). */
.xt-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 18rpx;
  border-radius: 5rpx;
  background-color: var(--muted);
}

.xt-reason-text {
  flex: 1;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---- items ---- */
.xt-list-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 44rpx;
}

.xt-section-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
}

.xt-flat {
  margin-bottom: 0;
}

.xt-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1px solid var(--rule);
}

.xt-known {
  flex-shrink: 0;
  width: 56rpx;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}

.xt-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.xt-item-line {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 16rpx;
}

.xt-item-text {
  color: var(--ink);
  font-size: 34rpx;
}

.xt-item-known {
  color: var(--muted);
}

.xt-item-gloss {
  color: var(--ink-soft);
  font-size: 26rpx;
}

.xt-example {
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.55;
}

.xt-example-zh {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---- passage and grammar ---- */
.xt-passage {
  margin-top: 44rpx;
}

.xt-passage-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 看中文 and 朗读, side by side at the end of the head. */
.xt-passage-tools {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.xt-passage-text {
  display: block;
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 32rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.xt-passage-zh {
  display: block;
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

.xt-grammar {
  margin-top: 44rpx;
}

.xt-rule {
  display: block;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

.xt-pair {
  margin-top: 16rpx;
}

.xt-wrong {
  flex: 1;
  color: var(--muted);
  font-size: 30rpx;
  line-height: 1.6;
  text-decoration: line-through;
}

.xt-right {
  flex: 1;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
}

.xt-notice {
  display: block;
  margin-top: 40rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---- bottom bar ---- */
.xt-dismiss {
  padding: 0 8rpx;
  color: var(--ink-soft);
}

.xt-pdf {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 1px solid var(--rule);
}

.xt-grow {
  flex: 1;
}

/* ---- empty / error ---- */
.xt-none {
  padding: 96rpx 16rpx;
  text-align: center;
}

.xt-none-title {
  display: block;
  color: var(--ink);
  font-size: 32rpx;
}

.xt-none-note {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.xt-retry {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 24rpx;
}
