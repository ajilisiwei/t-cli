/* Layout only: type comes from the scale (.t-*), buttons, rows, marks, the
 * card and states from app.wxss (README "Design system"). Rows that mix
 * fonts or sizes are centred, never on a baseline (Skyline). */

.hero {
  padding-top: 24rpx;
}

/* ---- skeleton (app.wxss .skel), breathing while the unit loads ---- */
.skel-pulse {
  animation-name: it-pulse;
  animation-duration: 900ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes it-pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.45;
  }
}

/* A head word's height (56rpx type). */
.it-skel-head {
  width: 48%;
  height: 56rpx;
  margin-bottom: 24rpx;
}

.it-skel-gap {
  margin-top: 24rpx;
}

.it-w40 {
  width: 40%;
}

.it-w72 {
  width: 72%;
}

/* Why the content is missing or about to change: a quiet accent band on top. */
.status {
  display: block;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
  color: var(--accent);
}

/* Head word (serif), IPA and 朗读 differ in size: centred on one line. */
.it-headline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.it-head {
  word-break: break-word;
}

/* A phrase is longer than a word: the title size, still serif. */
.it-phrase {
  font-size: 40rpx;
  line-height: 1.35;
}

.it-gloss {
  display: block;
  margin-top: 12rpx;
}

.meta {
  display: block;
  margin-top: 8rpx;
}

/* Section labels inside the unit, and the blocks after it. */
.it-sec {
  margin-top: 24rpx;
}

.it-sec-major {
  margin-top: 48rpx;
}

.meanings {
  margin-top: 24rpx;
}

.meaning {
  display: block;
  margin-top: 8rpx;
}

.pos {
  color: var(--muted);
  font-style: italic;
}

.example {
  margin-top: 16rpx;
}

/* The user's own sentence: an accent hairline on the left (a square box). */
.example-mine {
  padding-left: 24rpx;
  border-left: 4rpx solid var(--accent);
}

.mine {
  display: block;
  color: var(--accent);
}

.example-en {
  display: block;
  word-break: break-word;
}

.example-zh {
  display: block;
  margin-top: 8rpx;
}

.line {
  display: block;
  margin-top: 8rpx;
  word-break: break-word;
}

/* A synonym's note, inline after the word. */
.note {
  color: var(--muted);
  font-size: 28rpx;
}

.alternative {
  margin-top: 16rpx;
}

.note-block {
  display: block;
  color: var(--muted);
}

.grammar-title {
  display: block;
}

.grammar-rule {
  display: block;
  margin-top: 24rpx;
  color: var(--ink-soft);
}

.contrast {
  margin-top: 32rpx;
}

.contrast-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.contrast-right {
  margin-top: 12rpx;
}

.wrong {
  flex: 1;
  color: var(--muted);
  text-decoration: line-through;
}

.right {
  flex: 1;
  color: var(--accent);
}

.exercise {
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.exercise-wrong {
  display: block;
}

.exercise-right {
  margin-top: 8rpx;
}

.exercise-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--accent);
}

/* The card's state, inline after its type in a .row-label. */
.card-state {
  color: var(--muted);
  font-size: 28rpx;
}

.resting {
  color: var(--muted);
}

.source {
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
}

.source-input {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-word;
}

.source-time {
  display: block;
  margin-top: 8rpx;
}
