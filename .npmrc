# Never run dependency lifecycle scripts on install. None of our dependencies
# needs one (esbuild/fsevents are dev-only and work without), msedge-tts ships
# `preinstall: npx only-allow pnpm`, which fails under npm, and skipping them
# closes the install-script supply-chain path. `npm test` / `npm run <x>` still
# run their own script; this repo uses no pre/post hooks.
ignore-scripts=true
